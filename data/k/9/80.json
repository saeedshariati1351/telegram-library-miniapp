[[88221,"تاریخ اشرار کاشان","آیت الله عبدالرسول مدنی کاشانی","","",3,"1370","مرسل‌","9",26],[88244,"بزرگان کاشان","افشین عاطفی","","سوم",3,"1381","افق‌ فردا","9",12],[88245,"بزرگان کاشان","افشین عاطفی","","دوم",3,"1381","افق‌ فردا","9",12],[88246,"بزرگان کاشان","افشین عاطفی","","اول",3,"1381","افق‌ فردا","9",26],[200065,"روزگاران ایران","عبدالحسین زرین‌کوب","","",1,"1375","سخن‌","9",32],[200068,"جغرافیای اداری هخامنشیان","آرنولد توین‌بی؛ حاضر در واقع رساله مستقلی است در زمینه جغرافیای تاریخی و جغرافیای اداری ایران باستان عصر هخامنشی، اثر \"آرنولد توینبی \"که به صورت پیوست جلد ششم کتاب \"بررسی تاریخ (A Stady of History) \"منتشر شده است .موضوع اصلی کتاب تحلیلی است درباره نقشه اداری و شیوه اداره ساتراپ‌ها و نظام کنترل آنها در دوره هخامنشی، همچنین بررسی شیوه مالیات‌گیری و تقسیم نواحی مالیاتی در دوره هخامنشی که به استناد کتاب هرودوت تدوین یافته است\" .توینبی \"نیروی محرکه دستگاه عظیم اداری هخامنشی را به شبکه نوین مالیاتی که داریوش بنا نهاد متکی می‌داند .وی همچنین به این نتیجه می‌رسد که نظام اداری هخامنشی‌ها در جهت جلب رضایت اتباع آنها بوده است نه فشار و نارض","همایون صنعتی‌زاده","",1,"1379","بنیاد موقوفات‌ دکتر محمود افشار","9",32],[200069,"تاریخ موسسات تمدنی جدید در ایران ( از حکومت آق قویونلوها به بعد) جلد سوم","حسین محبوبی اردکانی","","سوم",1,"1370","دانشگاه‌ تهران‌","9",32],[200070,"تاریخ موسسات تمدنی جدید در ایران ( از حکومت آق قویونلوها به بعد) جلد دوم","حسین محبوبی اردکانی","","دوم",1,"1370","دانشگاه‌ تهران‌","9",32],[200071,"تاریخ موسسات تمدنی جدید در ایران ( از حکومت آق قویونلوها به بعد) جلد یکم","حسین محبوبی اردکانی","","یکم",1,"1370","دانشگاه‌ تهران‌","9",32],[200074,"کهن دیارا","شهبانو فرح پهلوی","","",2,"1382","کتاب‌سرا","9",32],[200076,"رضا شاه:خاطرات سلیمان بهبودی، شمس پهلوی، علی ایزدی","غلامحسین میرزا صالحی","","",1,"1372","طرح نو","9",32],[166123,"ایران در زمان ساسانیان","آرتور امانوئل کریستن‌سن","","",4,"1935","نگاه‌","9",32],[268085,"سپیده دم در ایران","برنارد شولسته هولتوس","","",1,"1366","نشر نو","9",50],[230721,"منم تیمور جهانگشا","مارسل بریون","به 