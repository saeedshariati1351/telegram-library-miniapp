",3,"1345"],[199964,"سفرنامه خوزستان","رضاشاه پهلوی؛ سفرنامه خوزستان در سال 1303 هجری خورشیدی مصادف با 1924 میلادی نوشته شده است و یکی از مهم ترین رویدادهای تاریخ صد سال گذشته ایران را گام به گام دنبال می کند. سفرنامه مازندران، در سال 1305 یک سال پس از پادشاهی رضا شاه نوشته شده است. آن دو سفرنامه در همان زمانها انتشار محدودی یافت و نایاب بود، تا در اواخر پادشاهی محمد رضا شاه به مناسبت \"آئین ملی بزرگداشت پادشاهی پهلوی\" (1354، 1975م) از سوی مرکز پژوهش و نشر فرهنگ سیاسی دوران پهلوی بار دیگر منتشر شدند و در سال 1383 توسط \"نشر تلاش\" در خارج کشور تجدید چاپ گردید","","",2,"1303"],[151459,"انقلاب مشروطیت ایران، نیروها و هدف‌ها","بیژن جزنی","","",2,"1393"],[230259,"طرح جامعه شناسی و مبانی استراتژیک جنبش انقلابی ایران","بیژن جزنی","","",2,""],[50167,"\"چوپانیان در تاریخ ایلخانیان\" یا \"تاریخ آل چوپان\"","دکتر ابوالفضل نبئی","","",3,"1352"],[95941,"موسولینی و فاشیسم","بلینک‌هورن‌، مارتین‌، ۱۹۴۱- م.","محمد رفیعی مهرآبادی","",2,"1381"],[230260,"تاریخ سی ساله","بیژن جزنی","","",1,""],[101990,"\" شیخ خزعل و امارت های عرب خوزستان \"","\"حاج کاظم پورکاظم\"","","",1,"1382"],[248185,"تاریخ‌ عالم آرای عباسی","اسکندر بیگ ترکمان","","",1,"1364"],[17132,"جغرافیای تاریخی: شهر بزرگ هگمتان و انشان","جواد صدقی","","",5,"1353"]]