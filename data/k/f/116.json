انی نویسندگان آنها با انسانهای دیگر است. در میان این داستانها، داستان «در مصاف فرسودگان» از خانم «فرانسِس هاجِستِن بِرنِرت» و دو داستان «آزمون اعتماد» و «داننده راز» از خانم «آَنَه والِن بِرگ» در ردیف درخشان ترین داستانهایی است که تا کنون به فارسی برگردانده ام. ممکن نیست خواننده از کنار این داستان ها بی تفاوت بگذرد و منطق و احساس او ، تحت تأثیر فضای داستان و رفتار شخصیتهای آن قرار نگیرد","","","",2,"2003","","f",26],[129295,"رمان «کشیش وِیک فیلد»","","","",2,"2016","","f",26],[129304,"رمان بستام مکلا","اشکان آویشن ۱۳۹۰","","",2,"","","f",26],[129305,"رمان غمزه و کیوان بانو","اشکان آویشن","","",2,"","","f",26],[129315,"شاهنامه کامل فردوسی به نثر (متن کامل شاهنامه فردوسی به نثر پارسی سره بدون کاربرد واژگان بیگانه)","بازنویسی میترا مهرآبادی","","اوّل",1,"1379","روزگار","f",26],[129381,"نفس شیطان","ر. ک. نارایان","مرضیه خسروی","",1,"1403","قدیانی","f",26],[129385,"رزهالد","هرمان هسه","آرتین جهانشاهی، نگین جهانشاهی","",1,"1400","نسل روشن","f",26],[129387,"پنجاه درجه بالای صفر","علی چنگیزی","","",1,"1390","نشر چشمه","f",26],[129388,"به من بگو ابدیت یعنی چه","سارا دسن","محمدرضا قاسمی","",1,"1400","نشر نون","f",26],[129393,"مارگریتا دلچه ویتا","استفانو بنی","حانیه اینانلو","",2,"1394","کتاب خورشید","f",52],[129394,"کلیسای شیطان","ماشادو د آسیس","عبدالله کوثری","",1,"1400","انتشارات ماهی","f",26],[129395,"سرنوشت در دست کلوتیلد","جوانینو گوارسکی","هاله ناظمی","",1,"1396","شورآفرین","f",26],[129404,"نفرین شده","دن پابلوکی","مهرداد مهدویان","",2,"1397","‌ پیدایش","f",76],[129406,"سومین تسلیم: مجموعه داستان‌های کوتاه","گابریل گارسیا مارکز","اسماعیل قهرمانی‌پور","",2,"","نشر روزگار","f",26],[131717,"خوانش رمان راهنمای نویسندگان مقتول","","","",4,"","","f",51],[131719,"نقد و بررسی رمان کوبانی اثر ژان","","","",4,"","","f",51],[137779,"انگور فرنگی","آنتوان چخوف","عبدالحسین نوشین","",2,"1393","اکباتان","f",51],[137813,"تلفن همراه","استیون کینگ","ماندانا قهرمانلو","",2,"1389","افراز","f",51],[137847,"آینه های شهر","الیف شافاک","تهمینه زاردشت","",3,"1999","نیلوفر","f",51],[138931,"درم