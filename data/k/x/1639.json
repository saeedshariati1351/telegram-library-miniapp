واع مقالات کوتاه را به شکلی ساده و کاربردی همراه با مثال‌های متعدد تشریح می‌کند. در بخش سوم نیز نشان داده می‌شود چطور می‌توان مقالات کوتاه را بسط داده، به سوی مقالات طولانی‌تر حرکت کرد. داستان‌نویسی و ادبیات نمایشی را که کنار بگذرایم، این کتاب در همۀ انواع دیگر نگارش از جملۀ نگارش علمی و دانشگاهی، نگارش ژورنالیستی، گزارش‌نویسی، نقدنویسی و همۀ انواع نگارش عمومی ک","","",5,"1400","","",27],[160728,"فهرست و مقدمه کتاب","دکتر فرهاد بیانی","","",4,"","","",27],[160729,"نشر لوگوس منتشر کرد","کیث گرینت","دکتر ابراهیم توبه یانی و دکتر سید عبدالمجید طباطبایی لطفی","",4,"","","",27],[160730,"خیابان و جنسیت","","","",4,"","","",27],[160731,"فهرست و مقدمه کتاب نقد ادبی با رویکرد شناختی","خانم دکتر لیلا صادقی","","دوم",6,"","","",27],[160732,"فهرست و مقدمه کتاب نقد ادبی با رویکرد شناختی","خانم دکتر لیلا صادقی","","",4,"","","",27],[160733,"نوشته کارن وال-یورگنسن","ترجمۀ دکتر محسن گودرزی","","",3,"","","",27],[160734,"نشر لوگوس منتشر کرد","دکتر محمد هاشمی","","",6,"","","",27],[160735,"ویراست دوم","دکتر مسعود کوثری","","",2,"","","",27]]