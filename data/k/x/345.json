[[159304,"عرفان‌گری تابلوی دین‌های بزرگ و آینه تمام‌نمای آن است. این کتاب بر اساس عقیده‌های دینی برای آشنایی با عرفان پیش از اسلام فراهم گردیده و تبلوری از جلوه‌های اشراقی و روحانی آیین باستانی ایران است. کتاب متشکل از دو گفتار است. گفتار نخست به معرفی و کنکاش در اندیشه‌های عرفانی ایران باستان اختصاص دارد. در گفتار دوم احوال برخی زهدگرایان و عارف‌منشان ایران باستان از لابلای تاریخ و اسطوره بیان شده، از جمله ایرج، کیخسرو، لهراسب، رامین، تنسر، اردشیر بابک، ارداویراف، برزویه طبیب، بزرگمهر حکیم، خسرو پرویز","","","",1,""],[10402,"تاریخ ایران","سرپرسی سایکس","محمد تقی فخر داعی گیلانی","یکم",1,""],[36240,"ذهن نا آرام","","","",1,""],[41317,"tarix-ejameiran-j12","","","",3,""],[41318,"tarix-ejameiran-j11","","","",3,""],[41319,"تجربیات نزدیک به مرگ","","","",1,""],[82922,"عروض فارسی (شیوۀ نو برای آموزش عروض و قافیه)","عباس ماهیار","","",1,""],[105301,"rasmolxat-euyqori-sekkeshenasi-t","","","",1,""],[105302,"hakemiyat-emelli-va-doshmanan-ean-a","","","",1,""],[105303,"bamyandarbastan-va-dastan-j","","","",1,""],[105304,"zendeginame-mohsenhashtrudi","","","",1,""],[105305,"moahedat-enangin-eqajar-v1375","","","",1,""],[105306,"rasul-eaftab-d","","","",1,""],[105307,"muriane1372","","","",1,""],[105308,"qasran-k-b2","","","",2,""],[105309,"qasran-k-b1","","","",2,""],[105310,"rey-ebastan-k-j2","","","",1,""],[105311,"rey-ebastan-k-j1","","","",1,""],[105312,"darsgoftaridarbab-eamuzesh-o","","","",1,""],[105313,"enqelab-efaranse-va-rezhim-epishazan1391","","","",1,""],[126316,"2023 جنسیت، قدرت و هویت در فیلمهای استنلی کوبریک","","","",1,""],[159306,"سینما به روایت هیچکاک","فرانسوا تروفو","","",1,""],[159307,"سایه باد","","","",1,""],[159309,"پدرسالاری","اولین رید","افشنگ مقصودی","",1,""],[940,"پژوهشی درباره فرمانروایی هرمزد یکم شاهنشاه ایران و انیران","شهرام جلیلیان","","",1,""],[15357,"غزنویان: ترک منش یا پارسی گرا؟","سید نور تهماسبی خراسانی","","",1,""],[15358,"هرات باستان","آکادمی علوم افغانستان","","",1,""],[36322,"Zaman11","","","",6,""],[36323,"Zaman10","","","",6,""],[