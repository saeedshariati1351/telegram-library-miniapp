ف به حساب می آید، عناصر موجود در آثار کمدی و ملودرام تراژیک را در هم می آمیزد. ایوانف، بیش از اندازه باهوش و بیش از اندازه خسته است که بتواند زندگی روزمره ی خود را تحمل کند. او مردی کمال گراست و شیفته ی زن زیبا و جوانی شده که چارچوب های اخلاقی اش را به چالش می کشد و اتفاقاتی تراژیک را برایش رقم می","","","",1,""],[256305,"«گراکوس شکارچی و داستان های دیگر»","کافکا، چخوف، سارتر","صادق هدایت","",1,"1382"],[256324,"ئیون کره آنگا، مارک تواین، آنتون چخوف، لئونا کارینگتون، جیووانی گاره‌شی","ترجمۀ احمد شاملو","","",1,""],[266775,"مجموعه آثار چخوف (جلد دهم)","","","",1,""],[266776,"مجموعه آثار چخوف (جلد نهم)","","","",1,""],[266777,"مجموعه آثار چخوف (جلد هشتم)","","","",1,""],[266778,"مجموعه آثار چخوف (جلد هفتم)","","","",1,""],[266779,"مجموعه آثار چخوف (جلد ششم)","","","",1,""],[266780,"مجموعه آثار چخوف (جلد پنجم)","","","",1,""],[266781,"مجموعه آثار چخوف (جلد چهارم)","","","",1,""],[266782,"مجموعه آثار چخوف (جلد سوم)","","","",1,""],[266783,"مجموعه آثار چخوف (جلد دوم)","","","",1,""],[266784,"مجموعه آثار چخوف (جلد اول)","","","",1,""],[268083,"نمایشنامه‌های چخوف","آنتوان چخوف","","",1,""],[268281,"نمایشنامه سالگرد","آنتوان چخوف","","",1,""]]}