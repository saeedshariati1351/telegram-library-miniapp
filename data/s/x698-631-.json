را وارد ماجرای مردی دیوانه می کند که درپی آن اتفاقات و حوادثی مهیب شکل می گیرد","","","",1,""],[254918,"جهان اسطوره شناسی","ژرژ دو مزیل","","",1,""],[255294,"ژرفای زن بودن مورین مورداک","","","",2,""],[255484,"مقاله: \"نقد اسطوره ای آیین بومی «تیرما سیزّه شو» در مازندران (با رویکرد اسطوره سنجی ژُرژ دومزیل)\"","دکتر فتانه محمودی و سعید اخوانی","","",1,""],[255485,"اسطوره و اسطوره شناسی نزد ژرژ دومزیل","","","",1,""],[255655,"این نیز بگذرد","نگاهی ژرف به ناپایندگیِ همه چیز","","",1,""],[259604,"سخنان کوتاه و پرمغزی که از اندیشه ای ژرف یا پندی نغز و ظریف برخوردار است و به دلیل سادگی در عمق اندیشه های گذشتگان مقبولیت یافته و بر زبان خاص و عام جاری شده، \"مثل\" نام دارد. بسیاری از شاعران و نویسندگان کلام خود را به امثال و حکم آراسته و آن را پرمغز کرده اند. امثال رایج هر قوم، شاخصه مهم و ارزندهء ادبیات و پشتوانهء فرهنگ آن ملت است. تا کنون فرهنگ امثال زیادی گردآوری شده که فرهنگ «امثال و حکم» دهخدا کامل ترین و معتبرترین آنهاست. دکتر شکورزاده بلوری نیز در جمع آوری امثال فارسی تلاشی چشمگیر کرده و حسن کتاب او، علاوه بر کثرت امثال، یافتن معادل های هر \"مثل\" است. وی علاوه بر امثال عامیانه، امثال را در شعر شاعران","","","",1,""],[260492,"بخشی از کتاب ژرفای زن بودن","مورین مورداک","سیمین موحد","",1,""],[262825,"مرگ","ژرژ باتای","سارا خادمی","",1,""],[263172,"دیالتیک یا سیر جدالی و جامعه شناسی","ژرژ گورویچ","","",1,""],[264154,"یکی از نظامهای حقوقی مبتنی بر نظام رومی-ژرمنی که به خوبی اصول این نظام را پیاده کرده است، نظام حقوقی اطریش است که نگاه مختصری به آن مفید خواهد بود","","","",1,""],[264570,"اصول مقدماتی فلسفه","ژرژ پولیتسر","","",2,""],[264821,"خاندان خمینی به نگارش مهدی شمشیری، تحقیقی ژرف در زندگی روح الله خمینی","","","",1,""],[265130,"مرگ در پاریس-ژرژ سیمون","","","",2,""],[265279,"ژرفنا جورج اورول همایون حنیفه وند مقدم","","","",1,""],[265452,"معمای کلاه فروش","ژرژ سیمنون","","",1,""],[265453,"سفر مگره","ژرژ سیمنون","","",1,"1394"],[267729,"ثورا","ژرار آنکوس (پاپوس)","سودابه فضایلی","",1,"1377"],[268115,"جزیره ای در طوفان که در سال ۱۹۲۰ در پاریس انتشار یافت یکی از دو داس