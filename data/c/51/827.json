[[305450,"Nietzsche and Legal Theory Half","","","",1,"","","",51],[305451,"Lacan's Ethics and Nietzsche's","Tim Themi","","",1,"","","",51],[305452,"The Apartment","Sweta Kondavalasa","","",1,"","","",51],[305453,"Party.Discipline.and.Parliamentary.Politics","","","",1,"","","",51],[305454,"reginald-gibbons-how-poems-think","","","",1,"","","",51],[305455,"Handbook.of.International.Law","","","",1,"","","",51],[305456,"International.Law.and.its.Others","","","",1,"","","",51],[305457,"Secession.International.Law.Perspectives","","","",1,"","","",51],[305458,"The.Threat.of.Force.in.International.Law","","","",1,"","","",51],[305459,"The Deliberate Sinner","Bhaavna Arora","","",1,"","","",51],[305460,"سعدی شیرازی کتاب گلستان را یک سال بعد از نظم بوستان، در بهار سال۶۵۶هجری در شیراز نوشته است..گلستان دارای سبک و شیوه ای تازه و بی سابقه بود.در لفظ از همه اثار فصیح تر و در معنی بلیغ تر،نظم و نثرش پاکیزه و سنجیده بود.در این کتاب قصه هایی شبیه گلستان اورده شده.به همین دلیل قصه های گلستان و ملستان نام گرفته","","","",1,"","","",51],[305461,"شیخ عطار نیشابوری از شاعرای بسیار مشهور قرن ششم هجری است.وی مردی طبیب بوده و با کار خود در سراسر عمر به مردم خدمت می کرده است.اما بیشتر شهرت عطار ار آثار ادبی و اشعار اوست","","","",1,"","","p",51],[305462,"قرآن کریم قصه نیست،ولی چون برخی از احوال پیغمبران و سرگذشت دیگران از خوبان و بدان در ضمن آیات قرآن امده است وقتی این داستانها را جمع آوری می کنند آنها را قصه های قرآنی می نامند.یعنی قصه هایی که در قرآن به آنها اشاره شده است","","","",1,"","","",51],[305463,"این کتاب شامل بیست و چهار قصه ی برگزیده و نوساخته از کتاب مثنوی مولوی است. مثنوی مولوی یک از بهترین آثار ادبی فارسی است.که در دنیا نظیر و مانند ندارد‌","","","",1,"","","p",51],[305464,"سندبادنامه کتابی است داستانی که به زبان هندی قدیم نوشته.و بعدها به فارسی ترجمه شده است.انشاء قدیمی بسیار مشکل و وجود بیشتر قصه های بد در این کتاب.چرا که نویسنده شخص بدبین و کج خیالی بوده.و از افسانه های مزخرف بسیار است کرده است.به همین دلیل فقط داستانهای خوب و سودمند از کتاب انتخاب شده است","قابو","","",1,"","","",51],[305465,"این کتاب دارای بیست و یک قصه است.کتاب مرزبان نامه یکی از کتابهای بسیار مهم و معروف در زبان فارسی است.و از دو جهت اهمیت دارد:مطالبی که نموداری از آن در قصه ها می بینیم.و دیگر جهت انشاء آن که از اثار استادانه ادبی است","","","",1,"","","",51],[305466,"دارای. جایزه . قدیم","","","",1,"","","f",51],[305467,"مهدی آذر یزدی ویکی‌پدیا، دانشنامهٔ آزاد","","","",1,"","","",51],[305468,"دبیرستان امام صادق (ع)","حکیم نظامی قم","","",1,"","","",51],[157012,"دیوان صباکاشانی،فتح الله خان صبا کاشانی","","","",2,"","","p",26],[157016,"دیوان فتح الله خان صبا کاشانی","","","",2,"","","p",26],[305501,"Readers Digest USA 2020-09","","","",1,"","","",51],[305502,"06-01 Readers Digest AUNZ","","","",1,"","","",51],[305503,"Readers Digest UK 07 2020","","","",1,"","","",51],[305504,"readers-digest-uk-march-2020","","","",1,"","","",51],[305505,"07-01 Readers Digest","","","",1,"","","",51],[305506,"Readers Digest","COVID-19 2020","","",1,"","","",51],[305507,"2020 03 01 Readers Digest AUNZ","","","",1,"","","",51],[305508,"2020 06 01 Readers Digest Canada","","","",1,"","","",51],[305509,"2020 03 01 Reader s Digest India","","","",1,"","","",51],[305510,"Reader's Digest","November 2015","","",1,"","","",51],[305511,"Reader s Digest Canada March 2016","","","",1,"","","",51],[305512,"Reader s Digest International April 2016","","","",1,"","","",51],[305513,"Reader s Digest International May 2016","","","",1,"","","",51],[305514,"Reader s Digest UK June 2016","","","",1,"","","",51],[305515,"Reader s Digest UK July 2016","","","",1,"","","",51],[305516,"Reader s Digest International January 2016","","","",2,"","","",51],[305517,"Reader's Digest USA","June (2018)","","",1,"","","",51],[305518,"Readers Digest India","December 2015","","",2,"","","",51],[305519,"Reader s Digest India February 2016(1)","","","",1,"","","",51],[305520,"Reader s Digest Canada June 2016","","","",1,"","","",51],[305521,"Reader s Digest Canada July August 2016","","","",1,"","","",51],[3