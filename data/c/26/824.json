ه است.) همانطور که پیتر استالی‌برس و الون وایت استدلال کرده‌اند، گذار اروپای غربی از اقصاد روستایی به اقتصاد صنعتی و شهری به آن معنا بود که «موش دیگر یک عامل اقتصادی نیست (برای مثال، از بین‌برنده غلات): موش بدل به ابژه ترس و نفرت شد، تهدیدی برای تمدن.» در اواخر قرن نوزدهم","","","",1,"","","",26],[154760,"ینگه دنیا","جان دوس پاسوس","سعید باستانی","دوم : 1919",2,"","","",52],[154761,"تأثیر عناصر، شکل و ساختار شهرهای ساسانی بر شهرهای اولیهٔ دورهٔ اسلامی","پرنیا امیرحسینی","","",1,"","","",26],[154762,"تاریخ‌نگاری در ایرانِ پیش از اسلام","","","",2,"","","",26],[154765,"مقالۀ «درنگی بر فرهنگی»","","","",1,"","","",26],[154766,"دکتر سروش دباغ","","","",1,"","","",26],[154767,"احوال مشایخ کبار","سلیمان بن شیخ سعدالله","","",2,"1420","مرکز تحقیقات فارسی ایران و پاکستان","2",26],[154770,"مجید محمدی","","","",1,"","","",26],[154771,"فرهنگ ایرانی و اندیشه یونانی","پل کراوس، فرانتس روزنتال، عبدالرحمن بدوی ، دیمیتری گوتاس و دیگران","سید مهدی حسینی","",2,"1391","نشر علم","9",52],[154772,"عناصر زندگی شمال در شعر نیما","محمود نیکویه","","",1,"","","",26],[154773,"آینده نگاری رسانه ها","","","",4,"","","",72],[154774,"ترجمه و متن کامل","ثقة المحدثین ابومحمد الحسن حرانی","استاد علی اکبر میرزایی","",3,"","","",52],[154775,"پیشینه هنر شفاهی، گوسان","جهانگیر نصری اشرفی","","",1,"","","",26],[154776,"غرور و مصیبت","حسن شهباز","","",2,"","","",52],[154778,"دلاوران گمنام ایران","طاهری شهاب","","",1,"","","",26],[154779,"سفرنامه بهلر","مسیو بهلر","","",1,"1356","انتشارات توس","9",26],[154780,"ریشه شناسی واژه مانثره","مهدی علایی","","",1,"","","",26],[154782,"کوسان‌ها قدیمی‌ترین هنرمندان موسیقی در فلات ایران","جهانگیر نصری اشرفی","","",1,"","","",26],[154784,"کلیدهای طلایی مدیریت","رابرت اسلیتر","سیدجواد معتمدالشریعتی","",3,"1388","مرندیز","6",52],[154785,"تاریخ اسماعیلیان","برنارد لوئیس","فریدون بدره ای","",2,"1362","توس","9",52],[154786,"سیری در نخستین روزنامه‌های ایران ۲","دکتر محمد اسماعیل رضوانی","","",1,"","","",26],[154787,"این جامه که می‌بری","دکتر آرش اکبری مفاخر","","",1,"","",""