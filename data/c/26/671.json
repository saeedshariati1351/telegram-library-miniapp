ی از کهن‌ترین و لطیف‌ترین متون ادبیات پارسی است که از یک‌سو ما را در شناخت بهتر ادبیات و فرهنگ اسلامی یاری ‌می‌رساند، و از سوی دیگر با دغدغه‌ها و آموزه‌های معرفتی و طریقتی بزرگانی همچون حضرت شیخ ابوسعید ابوالخیر و حضرت خواجه یوسف همدانی قدس سرهما آشنا می‌سازد . این مجالس از یک جُنگ شامل ده ها رساله در باب تصوف از کتابخانه ی قونیه به شماره ۱۳۰۰ به دست آمد و تصحیح و منتشر شد","","","",1,"","","",26],[147496,"معارف","انتشارات مولی","","",1,"","","",26],[147497,"لوح سپید (انکار مدرن ذات بشر)","استیون پینکر","بهزاد سروری، دانیال قارونی","",1,"","","",26],[147498,"دولت در عصر پهلوی","","","",1,"","","",26],[33561,"نیما چشم جلال بود","جلال آل احمد و نیما یوشیج","","",6,"1376","کتاب‌ سیامک‌","8",5],[74300,"12 Gharn Shokuh","","","",2,"","","",9],[74315,"12GharnSokot 5","","","",2,"","","",9],[74316,"12GharnSokot 4","","","",2,"","","",9],[74317,"12GharnSokot 3","","","",2,"","","",9],[74318,"12GharnSokot 2","","","",2,"","","",9],[74319,"12GharnSokot 1","","","",2,"","","",9],[32546,"سبک شناسی شعر","سیروس شمیسا","","",5,"1383","میترا","8",26],[157549,"آفرینش زیانکار","","","",4,"","","",27],[157907,"مسئله شناسی مطالعات سیاسی اسلامی","","","",4,"","","",27],[157908,"جشن نامه استاد مدرس رضوی","","","",3,"","","",27],[157909,"ایران شناسی چیست؟ نوشته داریوش آ","","","",4,"","","",27],[157912,"این کتاب به شما آرامش می دهد","","","",4,"","","",27],[38696,"Divane Jaami 2","","","",3,"","","",7],[38697,"Divane Jaami 1","","","",3,"","","",7]]