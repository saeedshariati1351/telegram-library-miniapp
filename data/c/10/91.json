[[85794,"دیوان اشعار صابر همدانی. اسدالله صنیعیان( صابر همدانی). به اهتمام و مقدمه کیوان سمیعی. تهران: زوار، 1361\"چاپ2\"","","","",1,""],[85795,"منطق الطیر. فریدالدین محمد عطار نیشابوری. به تصحیح و مقدمه و تعلیقات و حواشی محمدجواد مشکور. تهران؛ تبریز: کتابفروشی تهران، 1353\"چاپ4\"","","","",1,""],[85796,"برگزیده لغات کلیله و دمنه","عنایت‌الله شکیباپور","","",2,""],[85797,"نفثة‌المصدور","محمد زیدری نسوی","","",1,"1394"],[85798,"برگزیده سیاست‌نامه (سیَرالملوک)","نظام‌الملک طوسی","","",1,""],[85799,"گزیده قابوس‌نامه و سیاست‌نامه","توضیح جعفر شعار و نرگس روان‌پور","","",1,"1382"],[85800,"اگر غلط ننویسیم ابوالحسن نجفی را خوانده باشید، احتمالاً از نقد تندوتیزِ محمدرضا باطنی به آن نیز باخبرید که سال‌ها پیش در سه مقاله منتشر شد. باطنی در آن سه مقاله («اجازه بدهید غلط بنویسیم»، «هیاهوی بسیار بر سر هیچ»، «فارسی بیدی نیست که از این بادها بلرزد») همچنان که از عنوانشان نیز پیدا است، چندان ادب و آداب نقد را رعایت نکرده بود؛ گرچه پاره‌ای از انتقادهایش بجا و درخورتأمل بود. در همان سال‌ها شخصی به‌نام زهرا عنایت در مقاله‌ای به‌اسم «زبان‌شناسی: بهانه‌ای برای غلط‌نوشتن» پاسخ‌های درخوری به نقدهای محمدرضا باطنی داد؛ اما این مقاله چنان‌که باید، دیده نشد. واقعیت این است که نویسندۀ این مقاله نیز کمابیش مانند محمدرضا باطنی، آداب نقد را رعایت نکرده و تند رفته","","","",1,""],[85801,"دستور فارسی","ابوالقاسم پرتو","","",1,""],[22778,"تولدی دیگر","فروغ فرخزاد","","",3,"1377"],[85802,"\"فروغ فرخزاد به روایت رُمان\"","","","",1,""],[85803,"بیوگرافی فروغ فرخزاد","","","",1,""],[85804,"دفترشعر - اسیر","فروغ فرخزاد","","",1,""],[85805,"فروغ فرخزاد و سرزمین قدکوتاهان","میرزا آقا عسکری","","",1,""],[85807,"چهار نمونه پروپوزال آماده جهت آشنایی با قسمت های مختلف یک طرح پژوهشی","","","",1,""],[23513,"کتاب جمعه 12","","","",2,""],[85813,"ریشه شناسی و زبان فارسی","سید احمد رضا قائم مقامی","","",1,""],[85814,"کتاب جمعه. 36","","","",1,""],[85815,"کتاب جمعه35","","","",1,""],[85816,"کتاب جمعه34","","","",1,""],[85817,"کتاب جمعه. 33","","","",1,""],[85818,"کتاب جمعه. 32","","","",1,""],[85819,"کتاب جمعه.31","