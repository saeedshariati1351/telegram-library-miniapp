[[707022,"تمام مدت اورثینک میکنی؟ همش در حال فکر کردنی؟ این کتاب رو حتما بخون کمکت می‌کنه","","","",1,"","","",116],[707023,"این کتاب درباره روانشناسی دارک صحبت می‌کنه، مثلا فریب ذهن، خوندن افکار دیگران، کنترل کردن افراد و.... خیلی جالبه حقیقتا","","","",1,"","","",116],[707024,"اگر شما از آن دست افرادی هستید که هر اتفاقی که برای هر کس حادث میشود نتیجه تفکرات و تصمیمات خود همان شخص است و هر شخصی باید عواقب اعمال خود، چه نیک و چه بد را بپذیرد.اینکه چه چیزهایی برای شما و زندگیتان ارزش باشد؛ به گردن خودتان است. پس زندگی را برای خودتان سخت نکنید. چند چیز که در نظر شما بهترین است را انتخاب کنید و بینهایت برای خواسته هایتان تلاش کنید همین","","","",1,"","","",116],[707025,"این کتاب یک راهنمای درجه‌ یک برای مقابله با تفکر افراطی است. یعنی همان تفکری که شادی را از زندگی شما می‌رُباید و در بسیاری از موارد،‌ باعث قرارگرفتن شما در نوعی زندان ذهنی می‌شود","","","",1,"","","",116],[489090,"ازدواج بدون شکست","نوشته ویلیام گلاسر / ترجمه علی صاحبی","","",4,"1388","محقق‌","3",86],[79280,"Yung Yuga","","","",6,"","","",116],[164031,"پاسخ به ایوب گوستاو یونگ","","","",10,"","","",116],[707026,"چرا با آدم عوضی ازدواج می‌کنیم؟ از مجموعه‌ی مدرسه‌ی زندگی، قصد دارد، نخست دلایلی را که سبب می‌شود تا شما زندگی خود را پای یک آدم اشتباهی هدر دهید را ارائه و سپس کمک خواهد کرد تا خود را از این مهلکه نجات دهید","چرا با آدم‌ عوضی‌ ازدواج‌ میکنیم","","",1,"","","",116],[100829,"کاش قبل از ازدواج میدانستم?!","","","",4,"","","",116],[666428,"خودافشایی در ازدواج","","","",2,"","","",116],[707027,"راهنمای ازدواج","","","",1,"","","",116],[666441,"11. اشتباهات دوران آشنایی","","","",2,"","","",116],[188851,"قصه درمانی برای شب ادراری","","","",11,"","","",85],[468995,"قسمت هایی از کتاب و پروتکل طرحواره درمانی برای اختلال شخصیت مرزی","","","",9,"","","",86],[646906,"آموزش مهارت زندگی جرات مندی .تالیف شهرام محمد خانی","","","",4,"","","",78],[666414,"کتاب-آموزش-مهارت-های-زندگی","","","",3,"","","",86],[666415,"راهنمای بالینی اصول مشاوره مصرف موادمخدر","دکتر قهاری","","",3,"","","",86],[666416,"اضطراب و حمل