19,"پرنسس پابرهنه","اریک امانوئل اشمیت","@کتابخانه من شما","",1,"","","",76],[633820,"زمانی که یک اثر هنری بودم","اریک امانویل اشمیت؛ از ویژگی‌های مهم این رمان، نام شخصیت‌هاست. نام‌هایی چون زئوس، آدام، آنیبال و لویاتان که هریک ریشه‌ای اساطیری دارند و در جهان معاصر، در تضاد و تقابل با انسان رویکردهایی دیگرگون بروز می‌دهند. در شکلی دیگر می‌توان گفت، از آنجا که اسطوره­ها مکمل یکدیگرند، همیشه در قلمرو انسان","","",1,"1388","افراز","f",76],[633821,"اولیس از بغداد","اریک امانویل اشمیت؛ این کتاب ، داستان مهاجرت یکی از میلیون ها انسانی را روایت می کند که هم اکنون بر روی زمین به دنبال جایی برای زیستن می گردند؛ سعد می خواهد هرج و مرج بغداد را به مقصد اروپا","","",1,"1389","افراز","f",76],[633822,"اودت معمولی","اریک امانوئل اشمیت","@کتابخانه من شما","",1,"","","",76],[633823,"زیباترین کتاب دنیا ،اشمیت کتابخانه من شما","اریک امانوئل اشمیت","@کتابخانه من شما","",1,"","","",76],[633824,"خواهران باربارن ،اشمیت @کتابخانه من شما","اریک امانوئل اشمیت","@کتابخانه من شما","",1,"","","",76]]