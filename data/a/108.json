دی)، در برابر با استعمارگران، شاهنشاه ایران قیمت نفت را چهار برابر کرد","","",1,"1357"]],"r":[],"no":1,"nr":0},"اخلاقی بر پایه میراث یونان باستان را بررسی می کند این کتاب می تواند فرصتی جذاب باشد تا با اندیشمندی اشنا شود که در مرز میان جهان مسیحی":{"n":"اخلاقی بر پایه میراث یونان باستان را بررسی می‌کند. این کتاب می‌تواند فرصتی جذاب باشد تا با اندیشمندی آشنا شود که در مرز میان جهان مسیحی","o":[[204905,"رساله قوانین","فیلسوف برجسته اواخر بیزانس، کتابی برای کسانی که می‌خواهند از پشت صحنه تحولات فکری یکی از مهم‌ترین دوره‌های گذار تاریخ اروپا سر دربیاورند؛ اثری که در آن فلسفه نوافلاطونی، سیاست، قانون، دین و رؤیای بازسازی نظم اجتماعی درهم می‌آمیزند. آنچه امروز از این اثر در دست داریم، بخش‌هایی برجامانده از رساله‌ای بزرگ‌تر است که در قرن نوزدهم با جست‌وجو و مقابله نسخه‌های خطی گردآوری و منتشر شده و مقدمه مفصل کتاب نیز زندگی و اندیشه پلتون و تلاش او برای احیای نوعی نظام دینی و اخلاقی بر پایه میراث یونان باستان را بررسی می‌کند. این کتاب می‌تواند فرصتی جذاب باشد تا با اندیشمندی آشنا شود که در مرز میان جهان مسیحی، میراث یونانی و اندیشه سیاسی قرار گرفته و پرسش‌هایی ماندگار درباره قانون، جامعه، دی","","",1,""]],"r":[],"no":1,"nr":0},"انقلاب بالشویکی":{"n":"انقلاب بالشویکی","o":[[205786,"بوخارین","انقلاب بالشویکی","بیژن اشتری","",1,""]],"r":[],"no":1,"nr":0},"یک بازنویسی تجدیدنظرطلبانه در تاریخ دین":{"n":"یک بازنویسی تجدیدنظرطلبانه در تاریخ دین","o":[[206045,"و انسان خدا را همسان خود آفرید","یک بازنویسی تجدیدنظرطلبانه در تاریخ دین","","",1,""]],"r":[],"no":1,"nr":0},"متفکران چپ نو":{"n":"متفکران چپ نو","o":[[206384,"احمق‌ها، کلاهبرداران و فریبکاران","متفکران چپ نو","","",2,""]],"r":[],"no":1,"nr":0},"تجربیات 1945 1947":{"n":"تجربیات ۱۹۴۵-۱۹۴۷","o":[[206584,"نجات از اسارت","تجربیات ۱۹۴۵-۱۹۴۷","","",2,""]],"r":[],"no":1,"nr":0},"انتشارات شیرین":{"n":"انتشارات شیرین","o":[[210191,"ترجمه‌ محمدرضا رامور","انتشارات شیرین،چاپ اول۱۳۷۹","","",1,"1379"]],"r":[],"no":1,"nr":0},"انتشارات دانشگاه تهران1357":{"n":"انتشارات دانشگاه تهران۱۳۵۷","o":[[210936,"مقدمه سیدمحمدعلی جمالزاده","انتشارات د