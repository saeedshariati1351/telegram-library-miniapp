به سقوط تدریجی شخصیت اصلی داستان":{"n":"نمایشنامه ای تراژیک نوشته ی ویلیام شکسپیر است که در حدود سال 1605 میلادی به رشته ی تحریر درآمد. این نمایشنامه به سقوط تدریجی شخصیت اصلی داستان","o":[[81762,"شاه لیر","کتاب شاه لیر، نمایشنامه ای تراژیک نوشته ی ویلیام شکسپیر است که در حدود سال 1605 میلادی به رشته ی تحریر درآمد. این نمایشنامه به سقوط تدریجی شخصیت اصلی داستان، شاه لیر، به سوی دیوانگی و جنون می پردازد. شاه لیر به خاطر این که دو تن از سه دخترش در چاپلوسی و مجیزگویی از او موفق هستند، قلمرو پادشاهیِ خود را به آن ها می بخشد و باعث می شود عواقب تراژیک و غم انگیزی برای کل خانواده رقم بخورد. این نمایشنامه که از ماجرای اسطوره ایِ پادشاهی سلتیک به نام «لیرِ بریتانیا» گرفته شده، مورد اقتباس های بی شماری در تئاتر و سینما قرار گرفته و وظیفه ی اجرای نقش اصلی آن، به برترین و موفق ترین بازیگران هنرهای نمایشی سپرده شده است. شکسپیر در این اثر، عاطفه، بی رحمی، حمایت، غرور، خِرد و ضعف ان","","",1,"1403","شرکت عالی‌نشان پارسیان","",10]],"r":[],"no":1,"nr":0},"ناراجیان کوار و دیگران":{"n":"ناراجیان کوآر و دیگران","o":[[83116,"افسانه های مشرق زمین","ناراجیان کوآر و دیگران","محمد عباد زاده کرمانی","",1,"1379","هزار و یکشب‌","3",10]],"r":[],"no":1,"nr":0},"محمد جواد شریعت":{"n":"محمد جواد شریعت","o":[[83618,"آئینه عبرت ( شرح قصیده ایوان مدائن خاقانی شروانی )","محمد جواد شریعت","","",2,"","","",42],[83744,"کشف الاسرار و عده الابرار","محمد جواد شریعت","","",1,"","","",10],[85120,"دستور زبان فارسی","محمد جواد شریعت","","",2,"1345","اساطیر","4",10]],"r":[[164043,"ترجمه مبادی العربیه","معلم رشید الشرتونی","محمد جواد شریعت","",2,"","مشعل‌","4",27]],"no":3,"nr":1},"سید احمد حسینی اشکوری":{"n":"سید احمد حسینی اشکوری","o":[[84960,"تذکره شاعران فارسی سرا","سید احمد حسینی اشکوری","","",1,"1441","تراث اسلامی؛ استامبول","8",10]],"r":[],"no":1,"nr":0},"ویلیام مونتگمری وات":{"n":"ویلیام مونتگمری وات","o":[[87402,"محمد رسول الله (ص)","ویلیام مونتگمری وات","اسمعیل والی‌زاده","",1,"","","",12],[226085,"رازورزی صوفیانه","ویلیام مونتگُمری وات","حمیدرضا شریعتمداری","",1,"","","",41]],"r":[],"no":2,"nr":0},"رن