دانشگاهی است که به آموزش اصول و روش‌های نگارش مقالات کوتاهِ عمومی اختصاص دارد. این کتاب که در نوع خود بی‌نظیر است، مبتنی بر اصول رتوریک، در بخش اول و دوم، ساختمان و انواع مقالات کوتاه را به شکلی ساده و کاربردی همراه با مثال‌های متعدد تشریح می‌کند. در بخش سوم نیز نشان داده می‌شود چطور می‌توان مقالات کوتاه را بسط داده، به سوی مقالات طولانی‌تر حرکت کرد. داستان‌نویسی و ادبیات نمایشی را که کنار بگذرایم، این کتاب در همۀ انواع دیگر نگارش از جملۀ نگارش علمی و دانشگاهی، نگارش ژورنالیستی، گزارش‌نویسی، نقدنویسی و همۀ انواع نگارش عمومی ک","","",5,"1400"]],"r":[],"no":1,"nr":0},"و شرحی بر تاییه قصیده دعبل خزاعی":{"n":"و شرحی بر تائیه(قصیده) دعبل خزاعی","o":[],"r":[[161701,"از نجوای اندوه","مرتضی موسوی گرمارودی","و شرحی بر تائیه(قصیده) دعبل خزاعی","",2,"1388"]],"no":0,"nr":1},"زانکو یاری":{"n":"زانکو یاری","o":[],"r":[[164511,"شعر آزادی","پل الوار","زانکو یاری","",1,""]],"no":0,"nr":1},"26 june 2015":{"n":"26 June 2015","o":[[166566,"The Week USA","26 June 2015","","",1,""]],"r":[],"no":1,"nr":0},"امیرفریدون گرکانی":{"n":"امیرفریدون گرکانی","o":[],"r":[[166737,"راشومون و داستان‌های دیگر","ریونوسوکه آکوتاگاوا","امیرفریدون گرکانی","",1,""]],"no":0,"nr":1},"شیللر":{"n":"شیللر","o":[[167675,"نام: ژاندارک یا دوشیزه ارلئان","شیللر","بزرگ علوی","",1,""]],"r":[],"no":1,"nr":0}}