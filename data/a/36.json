ست نیست، بلکه فرآیندی عمیق است که شیوه اندیشیدن، اخلاق، فرهنگ و حتی معنای انسان بودن را دگرگون کرده است. نویسنده با تحلیل جریان‌هایی چون مارکسیسم، تکنوکراسی، جامعه مصرفی، انقلاب‌های فرهنگی دهه ۱۹۶۰ و نسبت مسیحیت با مدرنیته، خواننده را به بازاندیشی درباره سرنوشت تمدن غرب و آینده ارزش‌های انسانی دعوت می‌کند. کتاب برای علاقه‌مندان فلسفه، الهیات، اندیشه سیاسی و نقد مدرنیته، اثری تأمل‌برانگیز و الهام‌بخش است که بسیاری از پرسش‌های امروز را از منظری متفاوت و عمیق بررسی می‌کند","","",1,""]],"r":[],"no":1,"nr":0},"نسبت مسیحیت با مدرنیته":{"n":"نسبت مسیحیت با مدرنیته","o":[[204975,"عصر سکولاریزاسیون","یکی از مهم‌ترین متفکران سیاسی و فلسفی ایتالیا که تلاشی ژرف برای فهم ریشه‌های بحران معنوی و فرهنگی جهان مدرن است. نویسنده با نگاهی تاریخی و فلسفی نشان می‌دهد که سکولاریزاسیون صرفاً جدایی دین از سیاست نیست، بلکه فرآیندی عمیق است که شیوه اندیشیدن، اخلاق، فرهنگ و حتی معنای انسان بودن را دگرگون کرده است. نویسنده با تحلیل جریان‌هایی چون مارکسیسم، تکنوکراسی، جامعه مصرفی، انقلاب‌های فرهنگی دهه ۱۹۶۰ و نسبت مسیحیت با مدرنیته، خواننده را به بازاندیشی درباره سرنوشت تمدن غرب و آینده ارزش‌های انسانی دعوت می‌کند. کتاب برای علاقه‌مندان فلسفه، الهیات، اندیشه سیاسی و نقد مدرنیته، اثری تأمل‌برانگیز و الهام‌بخش است که بسیاری از پرسش‌های امروز را از منظری متفاوت و عمیق بررسی می‌کند","","",1,""]],"r":[],"no":1,"nr":0},"سرهنگ رلف پیترز":{"n":"سرهنگ رلف پیترز","o":[[205168,"خائن","سرهنگ رلف پیترز","","",1,""],[205171,"قابیل در گیتسبورگ","سرهنگ رلف پیترز","","",1,""]],"r":[],"no":2,"nr":0},"پایتخت بیزانس":{"n":"پایتخت بیزانس","o":[[205513,"کنستانتینوپولیس","پایتخت بیزانس","","",1,""]],"r":[],"no":1,"nr":0},"افرینش انسان در اتن و اورشلیم":{"n":"آفرینش انسان در آتن و اورشلیم","o":[[206320,"کلاغ، کبوتر و جغد مینروا","آفرینش انسان در آتن و اورشلیم","","",1,""]],"r":[],"no":1,"nr":0},"توکویل":{"n":"توکویل","o":[[207087,"انقلاب فرانسه","توکویل","","",1,""]],"r":[],"no":1,"nr":0},"دوم1363":{"n":"دوم۱۳۶۳","o":[[208250,"با مقدمه سبکتین سالور","انتشارات کتابخانه سنائی،دوم۱۳۶۳","","",1,""]],"r":[],"no":1,"nr":0},"