 از واقع‌گرایی اخلاقی","آیا خوب و بد، درست و نادرست، واقعیت‌هایی مستقل از سلیقه، قرارداد و باور ما هستند، یا اخلاق چیزی است که خود انسان‌ها می‌سازند؟ نویسنده با ورود به قلب مباحث فرااخلاق، از واقع‌گرایی اخلاقی دفاع می‌کند و در مسیر خود با دیدگاه‌هایی مانند نسبی‌گرایی، ذهن‌گرایی و نظریه‌های غیرشناخت‌گرایانه به گفت‌وگو و جدال می‌پردازد؛ اما جذابیت کتاب فقط در دفاع از یک موضع فلسفی نیست، بلکه در پرسش‌هایی است که مستقیماً به تجربه اخلاقی ما مربوط می‌شوند: اگر حقیقت اخلاقی وجود دارد، چگونه می‌توانیم آن را بشناسیم؟ چرا باید به آن عمل کنیم؟ آیا اختلاف‌نظرهای عمیق اخلاقی واقع‌گرایی را زیر سؤال می‌برند؟ و آیا علم تنها معیار شناخت واقعیت است؟ این کتاب که ساختاری نظام‌من","","",1,""]],"r":[],"no":1,"nr":0},"هنری":{"n":"هنری‌","o":[[205215,"عصر هوش مصنوعی و آینده ما انسان‌ها","کیسینجر، هنری‌، ۱۹۲۳ - م.","علی علی‌پناهی","",1,"1401"]],"r":[],"no":1,"nr":0},"مقالات منتشرشده بین سال های 1940 1952":{"n":"مقالات منتشرشده بین سال‌های ۱۹۴۰-۱۹۵۲","o":[[205424,"جلد دهم مجموعه آثار اریک فوگلین","مقالات منتشرشده بین سال‌های ۱۹۴۰-۱۹۵۲","","دهم",1,"1940"]],"r":[],"no":1,"nr":0},"marchapril 2022":{"n":"MarchApril 2022","o":[[206351,"National Geographic History","MarchApril 2022","","",1,""]],"r":[],"no":1,"nr":0},"احمد علیقلیان":{"n":"احمد علیقلیان","o":[],"r":[[206747,"تولد اروپا","ژاک لوگوف","احمد علیقلیان","",2,"1395"]],"no":0,"nr":1},"چاپ سوم1390":{"n":"چاپ سوم۱۳۹۰","o":[[207438,"شش دشمن آزادی بشر","نشرماهی،چاپ سوم۱۳۹۰","عزت الله فولادوند","",1,"1390"],[207502,"ترجمه سروش حبیبی","نشر فرهنگ معاصر،چاپ سوم۱۳۹۰","","",1,"1390"],[209868,"ترجمه فتاح محمدی","نشرهزاره سوم، چاپ سوم۱۳۹۰","","",1,"1390"],[210020,"طرح آموزه ها و مکتب های بودایی","چاپ سوم۱۳۹۰","ع پاشایی","",1,"1390"],[210135,"ترجمه محمد خیریان","نشرعطش،چاپ سوم۱۳۹۰","","",1,"1390"],[210136,"ترجمه محمد خیریان","انتشارات عطش،چاپ سوم۱۳۹۰","","",1,"1390"]],"r":[],"no":6,"nr":0},"موسسه مطبوعاتی عطایی":{"n":"موسسه مطبوعاتی عطائی","o":[[209382,"ترجمه م افشین","موسسه مطبوعاتی عطائی","","",1,""],[210921,"با مقدمه سیدمحمدعلی جمالزاده","موسسه مطب