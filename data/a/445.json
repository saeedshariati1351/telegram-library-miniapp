ست. هر چیزی موقعی آزاد میشود که مستقل بشود. سیاستی که نمی تواند مستقل بشود هیچگاه آزاد نخواهد شد. یک عقیده دینی یا یک ایدئولوژی و بطور کلی هر نوع عقیده ای می خواهد همه را هم عقیده سازد، همه را تابع یک عقیده سازد، همه را در یک اصل، در یک فکر، در یک دین، وحدت بدهد. او می تواند همه را در خود وحدت بدهد وقتی همه را از تفکر استقلالی خودشان متنزع و دور سازد. در اینجاست که کثرت از بین می رود. یک عقیده دینی یا یک ایدئولوژی سیاسی یا علمی می خواهد همه را همه عوامل زندگانی، همه افراد، همه امور، همه گروه ها، همه عواطف را تابع خود بسازد و تا بدینسان","","",2,""]],"r":[],"no":1,"nr":0},"الن زاگارل":{"n":"آلن زاگارل","o":[[200193,"(۴۶۸): باستان شناسی پیش از تاریخ منطقه بختیاری؛ ظهور شیوه زندگی در ارتفاعات","آلن زاگارل، ترجمه کوروش روستایی","","",1,""]],"r":[],"no":1,"nr":0},"پدر مورتنسن ترجمه ایرج فداییان":{"n":"پدر مورتنسن. ترجمه ایرج فداییان","o":[[200698,"مقاله فارسی( ترجمه)","پدر مورتنسن. ترجمه ایرج فداییان","","",1,""]],"r":[],"no":1,"nr":0},"فتح بن علی بنداری":{"n":"فتح بن علی بنداری","o":[[201555,"کانال دنیای باستان( کتابخانه)","فتح بن علی بنداری","محمّدحسین جلیلی","",1,""],[226733,"تاریخ سلسلهٔ سلجوقی","فتح بن علی بنداری","محمّدحسین جلیلی","",1,"1356"]],"r":[],"no":2,"nr":0},"پرونده ای برای مسجد جامع یزد":{"n":"پرونده ای برای مسجد جامع یزد","o":[[201828,"دویستمین شماره ماهنامه پرگار منتشر شد","پرونده ای برای مسجد جامع یزد","","",1,""]],"r":[],"no":1,"nr":0},"استان پنجم":{"n":"استان پنجم","o":[[202574,"فرهنگ جغرافیائی ایران","استان پنجم، کردستان","","پنجم",1,""]],"r":[],"no":1,"nr":0},"کارشناس ارشد فرهنگ":{"n":"کارشناس ارشد فرهنگ","o":[[204393,"مقاله: پژوهش و رازگشایی از متن درخت آسوریک و پیوند آن با فتح بابل به دست کوروش بزرگ","سعید کریمی (سعید ایران ویج)، کارشناس ارشد فرهنگ و زبان‌های باستانی","","",2,""]],"r":[],"no":1,"nr":0},"اثاری از متفکران نومحافظه کار غرب":{"n":"آثاری از متفکران نومحافظه‌کار غرب","o":[[206003,"راهنمای نومحافظه‌کاری","آثاری از متفکران نومحافظه‌کار غرب","","",1,""]],"r":[],"no":1,"nr":0},"انتشارات پویش":{"n":"انتشارات پویش","o":[[207537,"ترجمه آرسن نظ