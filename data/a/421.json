 این کتاب به‌ترتیب دربارۀ جغرافیا","o":[[200021,"پارتیان - اثر مالکوم کالج","«فصول این کتاب به‌ترتیب دربارۀ جغرافیا، آمدن قبایل پارتی به ایران، روابط پارت و روم، شیوۀ پادشاهی و حکومت آنان، اقتصاد و جامعۀ ایشان، دین و طرز به خاک سپردن مردگان، معماری، هنر، برافتادن و انقراض آنان، و آثار به‌جای‌مانده از ایشان است. در این کتاب نسبتاً مختصر و پرمایه مؤلف کوشیده است که از همۀ منابع مربوط به پارتی‌ها بهره برگیرد و با دقت‌نظر و حوصله‌ای بسیار به تحریر فصل‌های کتاب خود بپردازد. مؤلف به‌طور کلی سعی داشته که حتی‌المقدور از وقایع‌نگاری و بیان حوادث خونین و شرح جنگ‌ها کاسته و بر تاریخ مردم و جامعه و فرهنگ و هنر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","","",2,"","","",42]],"r":[],"no":1,"nr":0},"the ancient world s":{"n":"‘The ancient world's","o":[[201277,"Eberhard Sauer","‘The ancient world's","","",1,"","","",33]],"r":[],"no":1,"nr":0},"کاظم عرب":{"n":"کاظم عرب","o":[[201944,"(۶۱۸۹): نگارکندهای کوچری گلپایگان، تحلیل و گونه شناسی","کاظم عرب، شقایق هورشید","","",1,"","","",33]],"r":[],"no":1,"nr":0},"سمانه پالیزوان":{"n":"سمانه پالیزوان","o":[[202086,"(۶۰۱۵): مطالعه ترکیب آلیاژ و روش ساخت سنجاق سرهای مفرغی متعلق به عصرآهن محوطه دایاآردیزی مورانی لرستان","سمانه پالیزوان، امید عودباشی، محمد مرتضوی، عطا حسن پور","","",1,"","","",33]],"r":[],"no":1,"nr":0},"اورین د یالوم":{"n":"اورین د یالوم","o":[[204700,"مامان و معنای زندگی","اورین د یالوم","","",1,"1400","نیک‌فرجام","6",36]],"r":[],"no":1,"nr":0},"فریناز فربود دانشجوی دکتری پژوهش هنر":{"n":"فریناز فربود [دانشجوی دکتری پژوهش هنر","o":[[204818,"بررسی تطبیقی منسوجات ایران ساسانی و روم شرقی","فریناز فربود [دانشجوی دکتری پژوهش هنر، دانشگاه تربیت مدرس تهران، ایران]؛ دکتر محمدرضا پورجعفر [دانشیار گروه شهرسازی، دانشکده هنر، دانشگاه تربیت مدرس، تهران، ایران]","","",1,"","","",37]],"r":[],"no":1,"nr":0},"رضا حبیبی نژاد":{"n":"رضا حبیبی نژاد","o":[[204832,"مقاله شماره یک مقاله","رضا حبیبی نژاد","","",1,"","","",37]],"r":[],"no":1,"nr":0},"ایوان الکساندرویچ ایلین":{"n":"ایوان الکساندرویچ ایلین","o"