نر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","o":[[200021,"پارتیان - اثر مالکوم کالج","«فصول این کتاب به‌ترتیب دربارۀ جغرافیا، آمدن قبایل پارتی به ایران، روابط پارت و روم، شیوۀ پادشاهی و حکومت آنان، اقتصاد و جامعۀ ایشان، دین و طرز به خاک سپردن مردگان، معماری، هنر، برافتادن و انقراض آنان، و آثار به‌جای‌مانده از ایشان است. در این کتاب نسبتاً مختصر و پرمایه مؤلف کوشیده است که از همۀ منابع مربوط به پارتی‌ها بهره برگیرد و با دقت‌نظر و حوصله‌ای بسیار به تحریر فصل‌های کتاب خود بپردازد. مؤلف به‌طور کلی سعی داشته که حتی‌المقدور از وقایع‌نگاری و بیان حوادث خونین و شرح جنگ‌ها کاسته و بر تاریخ مردم و جامعه و فرهنگ و هنر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","","",2,""]],"r":[],"no":1,"nr":0},"محمد رضا زاهدی":{"n":"محمد رضا زاهدی","o":[[201557,"(۹۳۹۱): جعل آثار تاریخی فرهنگی در ایران","محمد رضا زاهدی، حسن کریمیان","","",1,"1404"]],"r":[],"no":1,"nr":0},"ورامین گردی":{"n":"ورامین گردی","o":[[201938,"تهران، شهر موزه ها","ورامین گردی","","",2,""]],"r":[],"no":1,"nr":0},"استان مرکزی":{"n":"استان مرکزی","o":[[202582,"فرهنگ جغرافیائی ایران","استان مرکزی","","اول",1,""]],"r":[],"no":1,"nr":0},"رالف دی سایر":{"n":"رالف دی. سایر","o":[],"r":[[205207,"هفت اثر کلاسیک نظامی چین باستان، شامل هنر جنگ","","رالف دی. سایر","",2,""]],"no":0,"nr":1},"مصیبت برای شوالیه های تتونیک":{"n":"مصیبت برای شوالیه های تتونیک","o":[[206698,"تاننبرگ سال ۱۴۱۰ میلادی","مصیبت برای شوالیه های تتونیک","","",2,"1410"]],"r":[],"no":1,"nr":0},"1374":{"n":"۱۳۷۴","o":[[207973,"تاریخ و جغرافیا","انتشارات آستان قدس رضوی مشهد،۱۳۷۴","","",1,""],[210899,"ترجمه بیژن غیبی","انتشارات نمودار،بیلفلدآلمان،۱۳۷۴","","",1,""],[211287,"حکومتی که برای جهان دستور می نوشت (بنیاد استراتژی)","موسسه فرهنگی و انتشاراتی فروهر،۱۳۷۴","","",1,"1374"]],"r":[],"no":3,"nr":0},"پیشگفتارو ترجمه محمد فضایلی":{"n":"پیشگفتارو ترجمه محمد فضائلی","o":[[209892,"ترجمه مقدمه مجتبی مینوی","پیشگفتارو ترجمه محمد فضائلی","","",1,"1368"]],"r":[],"no":1,"nr":0},"انتشارات شم":{"