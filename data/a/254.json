","‌ یوحنا","6",47],[253614,"دایره المعارف بزرگ طب اسلامی گیاهان دارویی جلد دوم","مصطفی نورانی اردبیلی","","دوم",1,"1393","‌ یوحنا","6",47],[253615,"دایره المعارف بزرگ طب اسلامی گیاهان دارویی جلد اول","مصطفی نورانی اردبیلی","","اول",1,"1393","‌ یوحنا","6",47]],"r":[],"no":6,"nr":0},"استادیار دانشگاه هنر اسالمی تبریز":{"n":"استادیار دانشگاه هنر اسالمی تبریز","o":[[198158,"سنت سفالگری ناحیۀ خداآفرین و نظریۀ پویایی فرهنگی عصر آهن","استادیار دانشگاه هنر اسالمی تبریز","","",2,"","","",31]],"r":[],"no":1,"nr":0},"همه عواطف را تابع خود بسازد":{"n":"همه عواطف را تابع خود بسازد","o":[[199959,"جداسازی سیاست از دین","«دکتر منوچهر جمالی»؛ آزادی سیاسی در جامعه ای وجود دارد که سیاست آزاد وجود داشته باشد و سیاست موقعی آزاد است که مستقل است. هر چیزی موقعی آزاد میشود که مستقل بشود. سیاستی که نمی تواند مستقل بشود هیچگاه آزاد نخواهد شد. یک عقیده دینی یا یک ایدئولوژی و بطور کلی هر نوع عقیده ای می خواهد همه را هم عقیده سازد، همه را تابع یک عقیده سازد، همه را در یک اصل، در یک فکر، در یک دین، وحدت بدهد. او می تواند همه را در خود وحدت بدهد وقتی همه را از تفکر استقلالی خودشان متنزع و دور سازد. در اینجاست که کثرت از بین می رود. یک عقیده دینی یا یک ایدئولوژی سیاسی یا علمی می خواهد همه را همه عوامل زندگانی، همه افراد، همه امور، همه گروه ها، همه عواطف را تابع خود بسازد و تا بدینسان","","",2,"","","",32]],"r":[],"no":1,"nr":0},"هنر ان دوره بیفزاید از این جهت تاریخی که درباره پارتیان نوشته ایینه روزگار ان قوم است":{"n":"هنر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","o":[[200021,"پارتیان - اثر مالکوم کالج","«فصول این کتاب به‌ترتیب دربارۀ جغرافیا، آمدن قبایل پارتی به ایران، روابط پارت و روم، شیوۀ پادشاهی و حکومت آنان، اقتصاد و جامعۀ ایشان، دین و طرز به خاک سپردن مردگان، معماری، هنر، برافتادن و انقراض آنان، و آثار به‌جای‌مانده از ایشان است. در این کتاب نسبتاً مختصر و پرمایه مؤلف کوشیده است که از همۀ منابع مربوط به پارتی‌ها بهره برگیرد و با دقت‌نظر و حوصله‌ای بسیار به تحریر فصل‌های کتاب خود بپردازد. مؤلف به‌طور کلی سعی داشته که حتی‌المقدور از وقایع‌نگاری و بیان حوادث خونین و شرح جنگ‌ها کاسته و بر تاریخ مردم و جامعه و فرهنگ و هنر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","","",2,"","","",42]],"r":[],"no":1,"nr":0},"محمد رضا زاهدی":{"n":"محمد رضا زاهدی","o":[[201557,"(۹۳۹۱): جعل آثار تاریخی فرهنگی در ایران","محمد رضا زاهدی، حسن کریمیان","","",1,"1404","موزه ملی ایران","9",33]],"r":[],"no":1,"nr":0},"ورامین گردی":{"n":"ورامین گردی","o":[[201938,"تهران، شهر موزه ها","ورامین گردی","","",2,"","","",46]],"r":[],"no":1,"nr":0},"استان مرکزی":{"n":"استان مرکزی","o":[[202582,"فرهنگ جغرافیائی ایران","استان مرکزی","","اول",1,"","","",33]],"r":[],"no":1,"nr":0},"رالف دی سایر":{"n":"رالف دی. سایر","o":[],"r":[[205207,"هفت اثر کلاسیک نظامی چین باستان، شامل هنر جنگ","","رالف دی. سایر","",2,"","","",38]],"no":0,"nr":1},"مصیبت برای شوالیه های تتونیک":{"n":"مصیبت برای شوالیه های تتونیک","o":[[206698,"تاننبرگ سال ۱۴۱۰ میلادی","مصیبت برای شوالیه های تتونیک","","",2,"1410","","",40]],"r":[],"no":1,"nr":0},"1374":{"n":"۱۳۷۴","o":[[207973,"تاریخ و جغرافیا","انتشارات آستان قدس رضوی مشهد،۱۳۷۴","","",1,"","","",39],[210899,"ترجمه بیژن غیبی","انتشارات نمودار،بیلفلدآلمان،۱۳۷۴","","",1,"","","",39],[211287,"حکومتی که برای جهان دستور می نوشت (بنیاد استراتژی)","موسسه فرهنگی و انتشاراتی فروهر،۱۳۷۴","","",1,"1374","","",39]],"r":[],"no":3,"nr":0},"پیشگفتارو ترجمه محمد فضایلی":{"n":"پیشگفتارو ترجمه محمد فضائلی","o":[[209892,"ترجمه مقدمه مجتبی مینوی","پیشگفتارو ترجمه محمد فضائلی","","",1,"1368","","",39]],"r":[],"no":1,"nr":0},"انتشارات شم":{"n":"انتشارات شم","o":[[209966,"ترجمه محیا احمدی پور","انتشارات شم","","",1,"","","",39]],"r":[],"no":1,"nr":0},"انتشارات ارش":{"n":"انتشارات آرش","o":[[210173,"ترجمه بهمن فرزانه","انتشارات آرش،چاپ پنجم۱۳۶۷","","",1,"1367","","",39]],"r":[],"no":1,"nr":0},"چاپ دهم1388":{"n":"چاپ دهم۱۳۸۸","o":[[210332,"ترجمه محمدتقی بهرامی حران","نشرجامی،چاپ دهم۱۳۸۸","","",1,"1388","","",39]],"r":[],"no":1,"nr":0},"انتشارات نسل روشن1401":{"n":"انتشارات نسل روشن۱۴۰۱","o":[[210490,"ترجمه الهه مم