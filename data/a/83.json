یت، غرور، خِرد و ضعف ان","","",1,"1403"]],"r":[],"no":1,"nr":0},"دویل های پرهیجان خلق کرده است":{"n":"دوئل‌های پرهیجان خلق کرده است","o":[[81837,"شوالیه دارمانتال","داستان در اوایل قرن هجدهم میلادی و دوران نیابت سلطنت فیلیپ دوم، دوک اورلئان در فرانسه می‌گذرد. دوما در این کتاب، با آمیختن واقعیت‌های تاریخی و تخیل خلاقانه خود، فضایی پر از جاسوسی، عشق، خیانت و دوئل‌های پرهیجان خلق کرده است","","",1,"1371"]],"r":[],"no":1,"nr":0},"مرحوم دکتر علی محمد حق شناس":{"n":"مرحوم دکتر علی محمد حق‌‌شناس","o":[[82724,"آواشناسی","مرحوم دکتر علی محمد حق‌‌شناس","","",1,"1369"]],"r":[],"no":1,"nr":0},"بر اساس چاپ مسکو":{"n":"بر اساس چاپ مسکو","o":[[84876,"شاهنامه فردوسی","بر اساس چاپ مسکو","","",2,""]],"r":[],"no":1,"nr":0},"دکتر یزدان منصوریان":{"n":"دکتر یزدان منصوریان","o":[[84952,"صد ویژگی یک مقاله علمی پژوهشی خوب","دکتر یزدان منصوریان","","",1,""],[85749,"صد نکته در پایان‌نامه‌نویسی","دکتر یزدان منصوریان","","",1,""]],"r":[],"no":2,"nr":0},"رضاسیدحسینی":{"n":"رضاسیدحسینی","o":[[85566,"مکاتب ادبی","رضاسیدحسینی","","دو",1,""],[85567,"مکاتب ادبی","رضاسیدحسینی","","یک",1,""]],"r":[],"no":2,"nr":0},"دکتر احمد بهمنیار":{"n":"دکتر احمد بهمنیار","o":[[89440,"داستان‌نامه بهمنیاری","دکتر احمد بهمنیار","","",2,"1369"]],"r":[],"no":1,"nr":0},"باقر طالبی اردستانی":{"n":"باقر طالبی اردستانی","o":[],"r":[[89749,"سیری در تلمود","ادین اشتاین سالتز","باقر طالبی اردستانی","",2,"1383"]],"no":0,"nr":1},"گلشن راز شبستری":{"n":"گلشن راز شبستری","o":[[89882,"مفتاح فتوحات","گلشن راز شبستری","","",2,""]],"r":[],"no":1,"nr":0},"الیور لیمن":{"n":"الیور لیمن","o":[[90286,"تاریخ فلسفه اسلامی","سیدحسین نصر و الیور لیمن","گروهی از مترجمان","پنجم",2,""],[90287,"تاریخ فلسفه اسلامی","سیدحسین نصر و الیور لیمن","گروهی از مترجمان","چهارم",2,""],[90289,"تاریخ فلسفه اسلامی","سیدحسین نصر و الیور لیمن","گروهی از مترجمان","دوم",2,""],[90290,"تاریخ فلسفه اسلامی","سیدحسین نصر و الیور لیمن","گروهی از مترجمان","اول",2,""]],"r":[],"no":4,"nr":0},"غلامحسن محرمی":{"n":"غلامحسن محرمی","o":[[90470,"درسنامه تاریخ تشیع","غلامحسن محرم