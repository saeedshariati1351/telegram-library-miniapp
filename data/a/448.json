یروزی را بیش از دیگران می‌چشد و در بدترین حالت و در صورت شکست، حداقل پر دل و جرئت، شکست می‌خورد","","",1,"","","",47]],"r":[],"no":1,"nr":0},"کارشناسی ارشد مدیریت اجرایی":{"n":"کارشناسی ارشد مدیریت اجرایی","o":[[257822,"پاسخنامه تشریحی درس","کارشناسی ارشد مدیریت اجرایی","","",1,"","","",47],[257823,"کتابچه نمونه سوالات همراه پاسخنامه درس","کارشناسی ارشد مدیریت اجرایی","","",1,"","","",47],[257824,"پاسخنامه درس","کارشناسی ارشد مدیریت اجرایی","","",3,"","","",47],[257825,"نمونه سوال همراه پاسخنامه درس","کارشناسی ارشد مدیریت اجرایی","","",17,"","","",47],[257826,"نمونه سوال درس","کارشناسی ارشد مدیریت اجرایی","","",1,"","","",47]],"r":[],"no":5,"nr":0},"ری کنزی":{"n":"ری کنزی","o":[[258544,"\" جبر خطی \"","کنت هافمن ، ری کنزی","جمشید فرشیدی","",1,"1393","نگارنده دانش","5",47]],"r":[],"no":1,"nr":0},"مطابق کتب دکتر کاتوزیان":{"n":"مطابق کتب دکتر کاتوزیان","o":[[259433,"خلاصه مدنی 1تا8","مطابق کتب دکتر کاتوزیان","","",1,"","","",47]],"r":[],"no":1,"nr":0},"مکاتب هنری":{"n":"مکاتب هنری\"","o":[[265331,"مختصر و مفید","\"سبک ها و مکاتب هنری\"","","",1,"","","",47]],"r":[],"no":1,"nr":0},"1927":{"n":"۱۹۲۷","o":[[267459,"۹۵۶- بزم و رزم","چاپ استانبول، ۱۹۲۷","","",1,"1927","","",49]],"r":[],"no":1,"nr":0}}