"o":[[253181,"نارنیا شیر کمد جادوگر","سی اس لوییس کلایو استیپلز لوییس؛ لوسی پس از چند ساعت از نارنیا بازمی‌گردد و متوجه می‌شود که فقط چند ثانیه از زمین دور‌ بوده‌است، زیرا بازدید از سرزمین جادویی نارنیا بیشتر از مدت عدم حضور آن‌ها در زمین طول می‌کشد. وقتی لوسی درباره نارنیا به خواهر و برادرانش می‌گوید، آن‌ها حرف او را باور نمی‌کنند؛ ادموند با جادوگر سفید ملاقات می‌کند، جادوگر ادموند را فریب می‌دهد و او را متقاعد می‌کند که خواهران و برادرش را با قول شاهزاده شدن نزد او بیاورد","","",1,"1402"]],"r":[],"no":1,"nr":0},"نورهان":{"n":"نورهان","o":[[257455,"تازه‌ای از محمدعلی موحد در راه است به نام «در کشاکش دین و دولت» (ناشر: نشر ماهی)","نورهان","","",1,""]],"r":[],"no":1,"nr":0},"محمد رضا حکیمی محمد حکیمی علی حکیمی":{"n":"محمد رضا حکیمی|محمد حکیمی|علی حکیمی","o":[[261713,"الحیاة جلد ۶","محمد رضا حکیمی|محمد حکیمی|علی حکیمی","","6",1,"1395"],[261714,"الحیاة جلد ۵","محمد رضا حکیمی|محمد حکیمی|علی حکیمی","","5",1,"1395"],[261715,"الحیاة جلد ۴","محمد رضا حکیمی|محمد حکیمی|علی حکیمی","","4",1,"1395"],[261716,"الحیاة جلد ۳","محمد رضا حکیمی|محمد حکیمی|علی حکیمی","","3",1,"1395"],[261717,"الحیاة جلد ۲","محمد رضا حکیمی|محمد حکیمی|علی حکیمی","","2",1,"1395"],[261718,"الحیاة جلد ۱","محمد رضا حکیمی|محمد حکیمی|علی حکیمی","","1",1,"1395"]],"r":[],"no":6,"nr":0},"ریچارد بندلر جان گریندر":{"n":"ریچارد بندلر & جان گریندر","o":[[262672,"ساختار جادو یا جادوی کامیابی","ریچارد بندلر & جان گریندر","مجردزاده کرمانی","",2,""]],"r":[],"no":1,"nr":0},"فریده صارمی":{"n":"فریده صارمی","o":[],"r":[[266956,"مردی که آن جا نبود","جوئل و اتان کوئن","فریده صارمی","",1,""]],"no":0,"nr":1},"فارسی کتاب توسط دکتر ناصر ملامد انجام شده":{"n":"فارسی کتاب توسط دکتر ناصر ملامد انجام شده","o":[],"r":[[267764,"فن شراب‌سازی","اَنگِر و فرانسوا","فارسی کتاب توسط دکتر ناصر ملامد انجام شده و در سال ۱۳۵۳ منتشر شده است","",1,"1353"]],"no":0,"nr":1}}