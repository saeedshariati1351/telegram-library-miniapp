ن قبایل پارتی به ایران، روابط پارت و روم، شیوۀ پادشاهی و حکومت آنان، اقتصاد و جامعۀ ایشان، دین و طرز به خاک سپردن مردگان، معماری، هنر، برافتادن و انقراض آنان، و آثار به‌جای‌مانده از ایشان است. در این کتاب نسبتاً مختصر و پرمایه مؤلف کوشیده است که از همۀ منابع مربوط به پارتی‌ها بهره برگیرد و با دقت‌نظر و حوصله‌ای بسیار به تحریر فصل‌های کتاب خود بپردازد. مؤلف به‌طور کلی سعی داشته که حتی‌المقدور از وقایع‌نگاری و بیان حوادث خونین و شرح جنگ‌ها کاسته و بر تاریخ مردم و جامعه و فرهنگ و هنر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","","",2,""]],"r":[],"no":1,"nr":0},"هادی قایم پناه":{"n":"هادی قائم پناه","o":[[200553,"(۴٠۷۷): مطالعه تطبیقی نقش برجسته های صخره ای بیستون و آرامگاه داریوش","هادی قائم پناه","","",1,""],[203601,"(۳۳۴۲): پژوهشی بصری در پیشینه، ویژگی ها و بازنمایی نقوش تمدن های دیگر در نقش برجسته بیستون","هادی قائم پناه، مهتاب مبینی","","",1,""]],"r":[],"no":2,"nr":0},"rmatthews czap tehran2013":{"n":"RMatthews CZAP Tehran2013","o":[[200824,"52","RMatthews CZAP Tehran2013","","",1,""]],"r":[],"no":1,"nr":0},"یوسف افتخاری":{"n":"یوسف افتخاری","o":[[202137,"فرهنگ نماد‌ها بر سکه‌های اشکانی","یوسف افتخاری و محمود جمشیدی درمنی","","",1,""],[229855,"خاطرات دوران سپری شده","یوسف افتخاری","","",2,"1370"]],"r":[],"no":2,"nr":0},"نوشته سید احمدرضا حسینی":{"n":"نوشتۀ سید احمدرضا حسینی","o":[[203880,"پروپاگاندای نبش‌گور کتاب استر و سیزده به‌در","نوشتۀ سید احمدرضا حسینی","","",1,""]],"r":[],"no":1,"nr":0},"شماره یازده":{"n":"شماره یازده","o":[[203969,"احصائیه تجارتی ایران، اداره کل گمرکات، کتابچه عمومی تجارت با ممالک","شماره یازده","","",1,""]],"r":[],"no":1,"nr":0},"فرزند ژنرال":{"n":"فرزند ژنرال","o":[[205022,"تایوان","فرزند ژنرال","داود حیدری","",2,""]],"r":[],"no":1,"nr":0},"مسکو":{"n":"مسکو","o":[[206341,"سه رُم","مسکو، کنستانتینوپول و رُم","","",1,""]],"r":[],"no":1,"nr":0},"چالش های والدینی و خویشاوندی":{"n":"چالش‌های والدینی و خویشاوندی","o":[[206577,"روان‌شناسی فرگشتی/جلد سوّم","چالش‌های والدینی و خویشاوندی","آرش حسینیان","",1,"