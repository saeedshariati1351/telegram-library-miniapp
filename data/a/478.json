 برای گرفتن حق سایر کشورهای جهان گام بر میداشت","o":[[204446,"برای نخستین بار در اینترنت","در این کتاب با هفت شرکت نفتی بزرگ جهان آشنا می‌شوید و خواهید دید که چطور محمدرضا شاه با تأسیس سازمان \" اوپِک\" (OPEC) و متحد کردن کشورهای نفت‌خیز، نه تنها برای حقوق ملت ایران، بلکه برای گرفتن حق سایر کشورهای جهان گام بر میداشت و چگونه در دهه هفتاد میلادی (دهه پنجاه خورشیدی)، در تقابل با استعمارگران، شاهنشاه ایران قیمت نفت را چهار برابر کرد","","",1,"1357","","",35]],"r":[],"no":1,"nr":0},"نظریه های غیرشناخت گرایانه به گفت وگو":{"n":"نظریه‌های غیرشناخت‌گرایانه به گفت‌وگو","o":[[204873,"در دفاع از واقع‌گرایی اخلاقی","آیا خوب و بد، درست و نادرست، واقعیت‌هایی مستقل از سلیقه، قرارداد و باور ما هستند، یا اخلاق چیزی است که خود انسان‌ها می‌سازند؟ نویسنده با ورود به قلب مباحث فرااخلاق، از واقع‌گرایی اخلاقی دفاع می‌کند و در مسیر خود با دیدگاه‌هایی مانند نسبی‌گرایی، ذهن‌گرایی و نظریه‌های غیرشناخت‌گرایانه به گفت‌وگو و جدال می‌پردازد؛ اما جذابیت کتاب فقط در دفاع از یک موضع فلسفی نیست، بلکه در پرسش‌هایی است که مستقیماً به تجربه اخلاقی ما مربوط می‌شوند: اگر حقیقت اخلاقی وجود دارد، چگونه می‌توانیم آن را بشناسیم؟ چرا باید به آن عمل کنیم؟ آیا اختلاف‌نظرهای عمیق اخلاقی واقع‌گرایی را زیر سؤال می‌برند؟ و آیا علم تنها معیار شناخت واقعیت است؟ این کتاب که ساختاری نظام‌من","","",1,"","","",38]],"r":[],"no":1,"nr":0},"کالون":{"n":"کالون","o":[[205537,"وجدان بیدار","کالون و قیام کاستیلو","سیروس آرین‌پور","",1,"","","",38]],"r":[],"no":1,"nr":0},"پاپ پیوس پنجم":{"n":"پاپ پیوس پنجم","o":[[205648,"تعلیم‌نامهٔ شورای ترنت","پاپ پیوس پنجم و شورای ترنت","","",1,"","","",38]],"r":[],"no":1,"nr":0},"اسپانیا":{"n":"اسپانیا","o":[[207116,"آشنایی با کشورها","اسپانیا","","",2,"","","",43],[253077,"آشنایی با کشورهای جهان","اسپانیا","","",2,"1387","انتشارات آفتاب","",47]],"r":[],"no":2,"nr":0},"نشرالسانا1400":{"n":"نشرالسانا۱۴۰۰","o":[[208698,"ترجمه آذین نوذری","نشرالسانا۱۴۰۰","","",1,"1400","","",39]],"r":[],"no":1,"nr":0},"author richard alan miller":{"n":"Author Richard Alan Miller","o":[[209555,"Synthetic Telepat