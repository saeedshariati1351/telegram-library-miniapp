 15 می‌باشد","o":[[253410,"نکات مهم برای اساتید داوطلب تدریس درس تفسیر موضوعی قرآن (کتاب برمدار نور) به روش پرسش محور","کتاب «بر مدار نور» (درس تفسیر موضوعی) در مرحله دوم و آخر شامل درس 8 الی 15 می‌باشد؛ این کتاب شامل 15 درس می‌باشد که لازم است استاد مربوطه برنامه ریزی لازم را برای طول ترم داشته باشد؛ این کتاب شامل سؤالات پرتکرار دانشجویان در درس تفسیر موضوعی قرآن است و پاسخ ها هم توسط جمعی از اساتید معارف تهیه و تدوین شده است؛ هدف اصلی از طرح پرسش محور، جلب مشارکت دانشجویان برای گفتگو و تکمیل پاسخ می‌باشد. از این رو، تدریس یکطرفه با هدف طرح سازگار نیست؛ استادان محترم فایل را در اختیار دانشجویان قرار دهند و سؤالات پایان ترم را نیز از همین کتاب طرح نمایند؛ اساتیدی که در ثبت نام نکرده اند، اگ","","",1,""]],"r":[],"no":1,"nr":0},"جغرافیای گردشگری":{"n":"جغرافیای گردشگری","o":[[254018,"جغرافیای گردشگری","جغرافیای گردشگری","","",1,""]],"r":[],"no":1,"nr":0},"زناشویی است که مباحث ان برای علاقمندان بسیار سودمند است":{"n":"زناشویی است که مباحث آن برای علاقمندان بسیار سودمند است","o":[[261466,"تاریخ اجتماعی روابط جنسی در ایران","ویلم فلور از مهمترین پژوهشهای تاریخی و علمی درمورد روابط جنسی و زناشویی است که مباحث آن برای علاقمندان بسیار سودمند است","","",1,""]],"r":[],"no":1,"nr":0},"خواننده را گام به گام با کوچه ها":{"n":"خواننده را گام‌به‌گام با کوچه‌ها","o":[[267498,"سیاحتنامه شاردن","ژان شاردن، جواهرفروش و جهانگرد فرانسوی قرن هفدهم است که حاصل دو سفر و اقامتی چندساله در ایران عصر صفوی به‌شمار می‌رود . این اثر مفصل‌ترین و معتبرترین سفرنامه غربی درباره ایران است که ادوارد براون آن را معتبرترین تاریخ عهد صفوی دانسته و متفکرانی چون منتسکیو، ولتر و گیبون از آن بهره برده‌اند . شاردن به‌ویژه در توصیف جزئی‌نگرانه اصفهان دقتی شگفت‌انگیز دارد و مدعی است این شهر را بهتر از لندن می‌شناسد؛ بسیاری از بناهایی که او وصف کرده امروزه از میان رفته‌اند و نوشته‌هایش تنها منبع باقی‌مانده درباره آن‌هاست . ترجمه فارسی این مجموعه با عنوان «سیاحتنامه شاردن» توسط محمد عباسی در انتشارات امیرکبیر منتشر شده و خواننده را گام‌به‌گام با کوچه‌ها، بازارها و","","",1,""]],"r":[],"no":1,"nr":0}}