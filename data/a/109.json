 شهری‌ها، اصطلاح فلانی جواد است را درمقابل بچه جوادیه جعل کردند تا به قول خود جوادیه‌ای‌ها، روی آن","کتاب محله جوادیه که از مجموعه کتاب محلات سازمان نوسازی است و توسط فرشید رحیمی و محمدعلی مرادی تهیه شده است","","",1,""]],"r":[],"no":1,"nr":0},"شاه لیر":{"n":"شاه لیر","o":[[81762,"شاه لیر","کتاب شاه لیر، نمایشنامه ای تراژیک نوشته ی ویلیام شکسپیر است که در حدود سال 1605 میلادی به رشته ی تحریر درآمد. این نمایشنامه به سقوط تدریجی شخصیت اصلی داستان، شاه لیر، به سوی دیوانگی و جنون می پردازد. شاه لیر به خاطر این که دو تن از سه دخترش در چاپلوسی و مجیزگویی از او موفق هستند، قلمرو پادشاهیِ خود را به آن ها می بخشد و باعث می شود عواقب تراژیک و غم انگیزی برای کل خانواده رقم بخورد. این نمایشنامه که از ماجرای اسطوره ایِ پادشاهی سلتیک به نام «لیرِ بریتانیا» گرفته شده، مورد اقتباس های بی شماری در تئاتر و سینما قرار گرفته و وظیفه ی اجرای نقش اصلی آن، به برترین و موفق ترین بازیگران هنرهای نمایشی سپرده شده است. شکسپیر در این اثر، عاطفه، بی رحمی، حمایت، غرور، خِرد و ضعف ان","","",1,"1403"]],"r":[],"no":1,"nr":0},"یادنامه فروغ فرخزاد":{"n":"یادنامه فروغ فرخزاد","o":[[82024,"زنی تنها","یادنامه فروغ فرخزاد","","",4,""]],"r":[],"no":1,"nr":0},"دکتر محمدحسین خان محمدی":{"n":"دکتر محمدحسین خان‌ محمدی","o":[[85443,"چشم‌اندازی بر ادبیات غنایی ایران","دکتر محمدحسین خان‌ محمدی","","",6,"1394"]],"r":[],"no":1,"nr":0},"پروفسور محمود شیرانی":{"n":"پروفسور محمود شیرانی","o":[[85457,"نقد شعر العجم علامه شبلی نعمانی از محمود شیرانی ترجمه توفیق سبحانی","\" نقد شعر العجم شبلی نعمانی \"؛ پروفسور محمود شیرانی","دکتر شاپور چوهدری و دکتر توفیق ه.سبحانی","",1,""],[94003,"نقد شعرالعجم شبلی نعمانی","پروفسور محمود شیرانی","دکتر شاپور چوهدری و دکتر توفیق ه. سبحانی","",2,""]],"r":[],"no":2,"nr":0},"جمال الدین محمد عرفی شیرازی":{"n":"جمال الدین محمد عرفی شیرازی","o":[[86884,"کلیات عرفی شیرازی","جمال الدین محمد عرفی شیرازی","","",3,""],[148606,"کلیات عرفی شیرازی. 3","جمال الدین محمد عرفی شیرازی","","",1,""],[148607,"کلیات عرفی شیرازی. 2","جمال الدین محمد عرفی شیرازی","","",1,""],[148608,"کلیات عرفی شیرازی. 1","جمال