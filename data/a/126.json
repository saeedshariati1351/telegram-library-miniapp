م بزرگ ها نمی توانند باور کنند این دختر بلوند و دوست داشتنی مسئول این کارها است. آن ها در عوض به «توبی» مشکوک می شوند: مردی ژولیده که کهنه سرباز جنگ جهانی اول است و با سه اسلحه در دست، در تپه های اطراف پرسه می زند. «آنابل» می داند «بتی» گناهکار است و «توبی» بی گناه، اما باورها و افکار کودکانه این شخصیت باعث می شود او وارد معمایی تاریک و خطرناک شود—معمایی که «آنابل» را وارد دنیای خاکستری و سرشار از تضاد بز","لارن ولک","","",1,"","","",47]],"r":[],"no":2,"nr":0},"دکتر نرگس عباسی":{"n":"دکتر نرگس عباسی","o":[[189389,"آمار و احتمال ( رشته آمار )","دکتر نرگس عباسی ، دکتر علی شادرخ ، دکتر محمدقاسم وحیدی اصل","","",1,"1398","انتشارات دانشگاه پیام نور","5",31],[189392,"آمار و احتمال","دکتر نرگس عباسی","","",1,"1398","دانشگاه پیام نور","5",31],[197170,"آمار و احتمال 2","دکتر نرگس عباسی ، دکتر علی شادرخ، دکتر محمد قاسم وحیدی اصل","","",4,"1398","دانشگاه پیام نور","5",31],[237317,"جزوه روش های چند متغیره گسسته","دکتر نرگس عباسی","","",1,"","","",44],[254174,"آمار و احتمال 1","دکتر نرگس عباسی ، دکتر علی شادرخ، دکتر محمد قاسم وحیدی اصل","","",1,"1398","دانشگاه پیام نور","5",47],[254175,"آمار و احتمال دو","دکتر نرگس عباسی؛ دکتر علی شادرخ؛ دکتر محمد قاسم وحیدی اصل","","",1,"","","",47],[254176,"آمار و احتمال","دکتر نرگس عباسی؛ دکتر علی شادرخ؛ دکتر محمد قاسم وحیدی اصل","","",1,"1398","دانشگاه پیام نور","5",47]],"r":[],"no":7,"nr":0},"روبرت جامسون":{"n":"روبرت جامسون","o":[[191695,"(۲۴۰۰): فرهنگ لغات باستان شناسی (لاتین)","ایان شاو، روبرت جامسون","","",1,"","","",31]],"r":[],"no":1,"nr":0},"ترجمه علیرضا رحمتی":{"n":"ترجمه علیرضا رحمتی","o":[[192817,"(٣٨٣١): پاسارگاد؛ مرکز جهان","دیوید استروناخ، ترجمه علیرضا رحمتی","","",1,"","","",31]],"r":[],"no":1,"nr":0},"ترجمه احسان اشراقی":{"n":"ترجمه احسان اشراقی","o":[[193351,"(۴٧۰٩): ایران در ١٨٣٩-١٨۴۰ سفارت فوق العاده کنت دوسرسی","کنت دوسرسی، ترجمه احسان اشراقی","","",1,"","","",31]],"r":[],"no":1,"nr":0},"ترجمه الهام شوشتری زاده":{"n":"ترجمه الهام شوشتری زاده","o":[[193515,"(۴۵۴۴): دایره المعارف مصور تاریخ جهان از سپیده دم تمدن تا امروز","