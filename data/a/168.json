ستان عصر هخامنشی، اثر \"آرنولد توینبی \"که به صورت پیوست جلد ششم کتاب \"بررسی تاریخ (A Stady of History) \"منتشر شده است .موضوع اصلی کتاب تحلیلی است درباره نقشه اداری و شیوه اداره ساتراپ‌ها و نظام کنترل آنها در دوره هخامنشی، همچنین بررسی شیوه مالیات‌گیری و تقسیم نواحی مالیاتی در دوره هخامنشی که به استناد کتاب هرودوت تدوین یافته است\" .توینبی \"نیروی محرکه دستگاه عظیم اداری هخامنشی را به شبکه نوین مالیاتی که داریوش بنا نهاد متکی می‌داند .وی همچنین به این نتیجه می‌رسد که نظام اداری هخامنشی‌ها در جهت جلب رضایت اتباع آنها بوده است نه فشار و نارض","همایون صنعتی‌زاده","",1,"1379","بنیاد موقوفات‌ دکتر محمود افشار","9",32]],"r":[],"no":1,"nr":0},"محمد حیدری":{"n":"محمد حیدری","o":[[202045,"(۶۰۶۸): مطالعه باستان سنجی سفال های گورستان عصر مفرغی کشیک شهرستان نیکشهر","یاسین صدقی، مهدی رازانی، محمد حیدری","","",1,"","","",33]],"r":[],"no":1,"nr":0},"فرشته اذرخرداد":{"n":"فرشته آذرخرداد","o":[[203685,"(۵۵٧۰): تاملی نو بر ساختار حاکمیتی اشکانیان، ملوک الطوایفی یا حکومت مرکزی؟! با تکیه بر شواهد باستان شناسی","سامان فرزین، مریم ظهوریان، حسین کوهستانی، فرشته آذرخرداد","","",1,"","","",33]],"r":[],"no":1,"nr":0},"شانزده":{"n":"شانزده","o":[[204024,"گنجینه دست نویس های پهلوی و پژوهش های ایرانی","شانزده","","",1,"","","",35]],"r":[],"no":1,"nr":0},"جودیت ال شولری":{"n":"جودیت ال. شولری","o":[[205894,"خاطرات ادوارد تلر","ادوارد تلر و جودیت ال. شولری","","",1,"","","",38]],"r":[],"no":1,"nr":0},"گریم":{"n":"گریم‌","o":[[206617,"بهترین افسانه های دنیا","گریم‌، یاکوب‌ لودویگ‌ کارل‌، ۱۷۸۵ - ۱۸۶۳م‌.","هروس شبانی","اول",1,"1376","نشر آبنوس‌- ۱۳۷۶","",38]],"r":[],"no":1,"nr":0},"انتشارات مدبر":{"n":"انتشارات مدبر","o":[[208356,"گردآوری ناهید جهازی","انتشارات مدبر، چاپ اول۱۳۸۱","","",1,"1381","","",39],[209405,"ترجمه دکتر محمود خاتمی","انتشارات مدبر،چاپ اول۱۳۷۰","","",1,"1370","","",39]],"r":[],"no":2,"nr":0},"چاپ1392":{"n":"چاپ۱۳٩٢","o":[[214150,"ترجمه شاهرخ مکسوب","چاپ۱۳٩٢","","",2,"1392","","",39],[216977,"تصحیح و توضیح","چاپ۱۳۹۲","","",1,"1392","","",39],[217397,"ترجمه","چاپ۱۳۹۲","","",1,"13