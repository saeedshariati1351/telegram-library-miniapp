"",2,"","","",31]],"r":[],"no":1,"nr":0},"سارا سید خلیل اللهی":{"n":"سارا سید خلیل اللهی","o":[[202034,"(۶۰۸۴): جلوه های تصویری و نوشتاری فره یا خوره بر سکه های ساسانی (۲۲۴-۶۵۱ م)","سارا سید خلیل اللهی، محسن ابوالقاسمی","","",1,"","","",33]],"r":[],"no":1,"nr":0},"قصه های قدیم ایران":{"n":"قصه‌های قدیم ایران","o":[[204624,"دو شاهزاده برادر، به نام‌های شهریار (یا شهرباز) و شاه زمان، مورد خیانت زنان خود قرار می‌گیرند شاه زمان ترک پادشاهی کرده و راهی دیار برادر می‌شود و شهریار هم به انتقام خیانت همسرش هر شب دختری را به نکاح در می‌آورد و بامداد دستور قتلش را می‌داد. تا اینکه دیگر دختری در شهر نمی‌ماند و وزیر شهریار که دو دختر به نام‌های شهرزاد و دنیا زاد داشت و به شدت نگران این قضیه بود به پیشنهاد شهرزاد وی را به عقد پادشاه درمی‌آورد","عبداللطیف طسوجی، مجموعه‌ای از افسانه‌ها و قصه‌های قدیم ایران و هند و سرزمین‌های عربی است که در آن، احوال و آداب و رسوم مردم ایران و هند و عرب آمده و سرشار از حکایت‌های آموزنده و نکات پندآموز و اخلاقی است","","",1,"","","",35]],"r":[],"no":1,"nr":0},"ذهن گرایی":{"n":"ذهن‌گرایی","o":[[204873,"در دفاع از واقع‌گرایی اخلاقی","آیا خوب و بد، درست و نادرست، واقعیت‌هایی مستقل از سلیقه، قرارداد و باور ما هستند، یا اخلاق چیزی است که خود انسان‌ها می‌سازند؟ نویسنده با ورود به قلب مباحث فرااخلاق، از واقع‌گرایی اخلاقی دفاع می‌کند و در مسیر خود با دیدگاه‌هایی مانند نسبی‌گرایی، ذهن‌گرایی و نظریه‌های غیرشناخت‌گرایانه به گفت‌وگو و جدال می‌پردازد؛ اما جذابیت کتاب فقط در دفاع از یک موضع فلسفی نیست، بلکه در پرسش‌هایی است که مستقیماً به تجربه اخلاقی ما مربوط می‌شوند: اگر حقیقت اخلاقی وجود دارد، چگونه می‌توانیم آن را بشناسیم؟ چرا باید به آن عمل کنیم؟ آیا اختلاف‌نظرهای عمیق اخلاقی واقع‌گرایی را زیر سؤال می‌برند؟ و آیا علم تنها معیار شناخت واقعیت است؟ این کتاب که ساختاری نظام‌من","","",1,"","","",38]],"r":[],"no":1,"nr":0},"احمد مقیمی":{"n":"احمد مقیمی","o":[[205235,"ایستگاه خیام","احمد مقیمی","","",2,"","","",38]],"r":[],"no":1,"nr":0},"اوریل کامرون":{"n":"آوریل کامرون","o":[[205359,"مسائل بیزانسی","آوریل کامرون","","",1,"","","",38]],"r":[],"no":1,"nr":0},"حکایت