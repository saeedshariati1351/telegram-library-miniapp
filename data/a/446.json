 است نه فشار و نارض","همایون صنعتی‌زاده","",1,"1379"]],"r":[],"no":1,"nr":0},"مینا مدیحی":{"n":"مینا مدیحی","o":[[200188,"(۴٠۹۸): کاوش بازنگری غار کمربند شهرستان بهشهر، استان مازندران","حسن فاضلی نشلی، مجتبی صفری، یودیت تومالسکی، مینا مدیحی، نرجس حیدری، نرجس خان فینی، قاسم مرادی، یوسف فاضلی نشلی، زهرا آقاجان نسب","","",1,""]],"r":[],"no":1,"nr":0},"بایرام اقالاری":{"n":"بایرام آقالاری","o":[[202042,"(۶۰۷۱): برهمکنش های فرهنگی شمال غرب ایران و شرق آناتولی در عصر مفرغ قدیم (هزاره سوم قبل از میلاد)","بایرام آقالاری","","",1,""],[203693,"(۵۵۶١): نوسنگی آناتولی و ارتباط فرامنطقه ای با غرب ایران","بایرام آقالاری","","",1,""]],"r":[],"no":2,"nr":0},"شماره 90":{"n":"شماره 90","o":[[202206,"ماهنامه هنر و مردم","شماره 90","","",1,""]],"r":[],"no":1,"nr":0},"derek bailey":{"n":"Derek Bailey","o":[[204081,"Improvisation Its Nature and Practice in Music","Derek Bailey","","",1,""]],"r":[],"no":1,"nr":0},"پیروزی تاریخی سنگر":{"n":"پیروزی تاریخی / سنگر","o":[[204608,"شرحی بر کتاب","پیروزی تاریخی / سنگر","","",1,"1351"]],"r":[],"no":1,"nr":0},"نقد مدرنیته":{"n":"نقد مدرنیته","o":[[204975,"عصر سکولاریزاسیون","یکی از مهم‌ترین متفکران سیاسی و فلسفی ایتالیا که تلاشی ژرف برای فهم ریشه‌های بحران معنوی و فرهنگی جهان مدرن است. نویسنده با نگاهی تاریخی و فلسفی نشان می‌دهد که سکولاریزاسیون صرفاً جدایی دین از سیاست نیست، بلکه فرآیندی عمیق است که شیوه اندیشیدن، اخلاق، فرهنگ و حتی معنای انسان بودن را دگرگون کرده است. نویسنده با تحلیل جریان‌هایی چون مارکسیسم، تکنوکراسی، جامعه مصرفی، انقلاب‌های فرهنگی دهه ۱۹۶۰ و نسبت مسیحیت با مدرنیته، خواننده را به بازاندیشی درباره سرنوشت تمدن غرب و آینده ارزش‌های انسانی دعوت می‌کند. کتاب برای علاقه‌مندان فلسفه، الهیات، اندیشه سیاسی و نقد مدرنیته، اثری تأمل‌برانگیز و الهام‌بخش است که بسیاری از پرسش‌های امروز را از منظری متفاوت و عمیق بررسی می‌کند","","",1,""]],"r":[],"no":1,"nr":0},"غذا":{"n":"غذا","o":[[205891,"افسانه گیاهخواری","غذا، عدالت و پایداری","","",1,""]],"r":[],"no":1,"nr":0},"نشرشلفین":{"n":"نشرشلفین","o":[[210327,"فرهنگ و ادبیات شفاهی مردم مازندران آ