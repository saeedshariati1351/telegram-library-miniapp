 بارفیلد تغییر داد، پسر خوانده اوون بارفیلد، دوست لوئیس است","","",1,"","","",47],[253182,"نارنیا خواهرزاده جادوگر","سی اس لوییس کلایو استیپلز لوییس؛ پیتر ، سوزان ، ادموند و لوسی پونسی برای در امان ماندن از بمب‌باران جنگ جهانی دوم در سال ۱۹۴۰، از لندن به خانه پروفسور دیگوری کریک، که در حومه انگلستان است، می‌روند. لوسی هنگام گشت‌وگذار در خانه، به طور اتفاقی وارد کمد لباس می‌شود و وارد سرزمین جادویی نارنیا می‌شود. او در آنجا، یک « فایون » به نام آقای تامنس را ملاقات می‌کند","","",1,"1940","قدیانی‌","",47]],"r":[],"no":2,"nr":0},"سیر تحول تیوریهای مدیریت منابع":{"n":"سیر تحول تئوریهای مدیریت منابع","o":[[257772,"جزوه","سیر تحول تئوریهای مدیریت منابع","","",1,"","","",47]],"r":[],"no":1,"nr":0},"رسایل مشروطیت":{"n":"رسائل مشروطیت","o":[[262743,"خلاصه کتاب","رسائل مشروطیت","","",1,"","","",47]],"r":[],"no":1,"nr":0},"برایان کاکس جف فروشاو":{"n":"برایان کاکس جف فروشاو","o":[[268258,"جهان کوانتومی","برایان کاکس جف فروشاو","","",2,"1394","انتشارات پارسیک","5",50]],"r":[],"no":1,"nr":0}}