تقل بشود. سیاستی که نمی تواند مستقل بشود هیچگاه آزاد نخواهد شد. یک عقیده دینی یا یک ایدئولوژی و بطور کلی هر نوع عقیده ای می خواهد همه را هم عقیده سازد، همه را تابع یک عقیده سازد، همه را در یک اصل، در یک فکر، در یک دین، وحدت بدهد. او می تواند همه را در خود وحدت بدهد وقتی همه را از تفکر استقلالی خودشان متنزع و دور سازد. در اینجاست که کثرت از بین می رود. یک عقیده دینی یا یک ایدئولوژی سیاسی یا علمی می خواهد همه را همه عوامل زندگانی، همه افراد، همه امور، همه گروه ها، همه عواطف را تابع خود بسازد و تا بدینسان","","",2,""]],"r":[],"no":1,"nr":0},"ebrahimi et al":{"n":"Ebrahimi et al","o":[[200869,"06","Ebrahimi et al","","",1,""]],"r":[],"no":1,"nr":0},"رضا ریاحیان":{"n":"رضا ریاحیان","o":[[201117,"(۳۹۰۶): مطالعۀ تاریخی و باستان شناختی قلعه دختر شهر کرمان، روند ساخت و بازسازی ها، تاریخ گذاری و کاربری معماری","ساره طهماسبی زاده، مریم محمدی، سعید امیرحاجلو، رضا ریاحیان","","",1,""]],"r":[],"no":1,"nr":0},"زهرا نعمتی":{"n":"زهرا نعمتی","o":[[202317,"(۳۵۵۷): ارزیابی جایگاه بسترهای جغرافیایی بر استقرارهای باستانی دوره ساسانی در مناطق کوهستانی جنوب غرب ایران، مطالعه موردی دشت ارسنجان، استان فارس","زهرا نعمتی، کمال الدین نیکنامی، محسن حیدری دستنائی، ابراهیم روستایی فارسی","","",1,""]],"r":[],"no":1,"nr":0},"فری یرا":{"n":"فری یرا","o":[[202881,"(۳۴۷۲): بقایای جانوری یک محوطه استقراری کهن در خورستان، ایران (تپه تولایی)","ویلر پیرس، فری یرا","میثم علیئی، ایرج رضایی","",1,""]],"r":[],"no":1,"nr":0},"نصوح مطراقچی":{"n":"نصوح مطراقچی","o":[[203507,"بیان المنازل","نصوح مطراقچی","","",1,""]],"r":[],"no":1,"nr":0},"حسین محمدی":{"n":"حسین محمدی","o":[[204819,"بررسی تطبیقی میراث مشترک ایران و هند در عصر ساسانیان از افسانه تا تاریخ؛ به روایت شاهنامه فردوسی","حسین محمدی","","",1,""],[244756,"روابط فرهنگی ایران و هند در عصر ساسانیان","حسین محمدی","","",1,""]],"r":[],"no":2,"nr":0},"سعیدرضا منتظری":{"n":"سعیدرضا منتظری","o":[],"r":[[204872,"فلسفه‌ها و فرهنگ‌ها","فردریک چارلز کاپلستون","سعیدرضا منتظری و زهرا محرمی","",1,"1402"]],"no":0,"nr":1},"ارمان ماجدی":{"n":"آرمان ماجدی","o":[],"r":[[20532