ادرست، واقعیت‌هایی مستقل از سلیقه، قرارداد و باور ما هستند، یا اخلاق چیزی است که خود انسان‌ها می‌سازند؟ نویسنده با ورود به قلب مباحث فرااخلاق، از واقع‌گرایی اخلاقی دفاع می‌کند و در مسیر خود با دیدگاه‌هایی مانند نسبی‌گرایی، ذهن‌گرایی و نظریه‌های غیرشناخت‌گرایانه به گفت‌وگو و جدال می‌پردازد؛ اما جذابیت کتاب فقط در دفاع از یک موضع فلسفی نیست، بلکه در پرسش‌هایی است که مستقیماً به تجربه اخلاقی ما مربوط می‌شوند: اگر حقیقت اخلاقی وجود دارد، چگونه می‌توانیم آن را بشناسیم؟ چرا باید به آن عمل کنیم؟ آیا اختلاف‌نظرهای عمیق اخلاقی واقع‌گرایی را زیر سؤال می‌برند؟ و آیا علم تنها معیار شناخت واقعیت است؟ این کتاب که ساختاری نظام‌من","","",1,"","","",38]],"r":[],"no":1,"nr":0},"طاووس میکایلیان":{"n":"طاووس میکائلیان","o":[],"r":[[206309,"الهیات مسیحی","هنری تیسن","طاووس میکائلیان","",1,"","","",38]],"no":0,"nr":1},"نیرومندترین جنگجویان کلیسای کاتولیک":{"n":"نیرومندترین جنگجویان کلیسای کاتولیک","o":[[206699,"شوالیه های تتونیک","نیرومندترین جنگجویان کلیسای کاتولیک","","",2,"","","",40]],"r":[],"no":1,"nr":0},"شواردنادزه":{"n":"شواردنادزه","o":[[207123,"آزادی را آینده رقم می زند","شواردنادزه","","",1,"","","",38]],"r":[],"no":1,"nr":0},"زمستان1391":{"n":"زمستان۱۳۹۱","o":[[207695,"ترجمه دکتر بهاره دادرس","زمستان۱۳۹۱","","",1,"","","",39]],"r":[],"no":1,"nr":0},"نشرققنوس":{"n":"نشرققنوس","o":[[207760,"ترجمه پرویز شهدی","نشرققنوس،چاپ اول۱۳۷۹","","",1,"1379","","",39],[209696,"ترجمه ارسلان فصیحی","نشرققنوس،۱۳۹۴","","",1,"1394","","",39],[209863,"بین زبان و ژوئیسانس","نشرققنوس،چاپ اول۱۳۹۷","محمدعلی جعفری","",1,"1397","","",39],[209878,"ترجمه مازیار اسلامی","نشرققنوس،چاپ اول۱۳۸۶","","",1,"1386","","",39],[210587,"ترجمه فرید جواهرکلام","نشرققنوس","","",2,"","","",39]],"r":[],"no":5,"nr":0},"و تدوین دکتر حسن احمدی":{"n":"و تدوین دکتر حسن احمدی","o":[],"r":[[208211,"کریست،کانلی،فریه،اسمیت، گلداسمیت،راویلسون،سایکس،مکماهون، هانتینگتون، لندور،تیت،آنندال","چاپ اول۱۳۷۸","و تدوین دکتر حسن احمدی","",1,"1378","","",39]],"no":0,"nr":1},"نشرتندر":{"n":"نشرتندر","o":[[208439,"ترجمه محمد امینی لاهیجی","نشرت