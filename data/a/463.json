",1,""]],"r":[],"no":2,"nr":0},"اینده ارزش های انسانی دعوت می کند کتاب برای علاقه مندان فلسفه":{"n":"آینده ارزش‌های انسانی دعوت می‌کند. کتاب برای علاقه‌مندان فلسفه","o":[[204975,"عصر سکولاریزاسیون","یکی از مهم‌ترین متفکران سیاسی و فلسفی ایتالیا که تلاشی ژرف برای فهم ریشه‌های بحران معنوی و فرهنگی جهان مدرن است. نویسنده با نگاهی تاریخی و فلسفی نشان می‌دهد که سکولاریزاسیون صرفاً جدایی دین از سیاست نیست، بلکه فرآیندی عمیق است که شیوه اندیشیدن، اخلاق، فرهنگ و حتی معنای انسان بودن را دگرگون کرده است. نویسنده با تحلیل جریان‌هایی چون مارکسیسم، تکنوکراسی، جامعه مصرفی، انقلاب‌های فرهنگی دهه ۱۹۶۰ و نسبت مسیحیت با مدرنیته، خواننده را به بازاندیشی درباره سرنوشت تمدن غرب و آینده ارزش‌های انسانی دعوت می‌کند. کتاب برای علاقه‌مندان فلسفه، الهیات، اندیشه سیاسی و نقد مدرنیته، اثری تأمل‌برانگیز و الهام‌بخش است که بسیاری از پرسش‌های امروز را از منظری متفاوت و عمیق بررسی می‌کند","","",1,""]],"r":[],"no":1,"nr":0},"شکل گیری فرهنگ امریکایی":{"n":"شکل‌گیری فرهنگ آمریکایی","o":[[205526,"کلیسای مورمون در آمریکا","مورمونیسم و شکل‌گیری فرهنگ آمریکایی","","",1,""]],"r":[],"no":1,"nr":0},"وسنتره جاتکه":{"n":"وسنتره جاتکه","o":[[205897,"تئوری پادشاهی تایلند","وسنتره جاتکه و ایده انسان کامل","","",1,""]],"r":[],"no":1,"nr":0},"گودرز افتخاری جهرمی":{"n":"گودرز افتخاری جهرمی","o":[[205966,"بن مایه های رومی حقوق عمومی","پرهام مهرآرام و گودرز افتخاری جهرمی","","",1,""]],"r":[],"no":1,"nr":0},"انتشارات سنبله":{"n":"انتشارات سنبله","o":[[207540,"ترجمه محمد راه رخشان","انتشارات سنبله،هامبورگ، چاپ اول۱۳۷۳","","",1,"1373"]],"r":[],"no":1,"nr":0},"انتشارات کتابفروشی مروج":{"n":"انتشارات کتابفروشی مروج","o":[[209172,"باتصحیح و مقدمه سعید نفیسی","انتشارات کتابفروشی مروج،۱۳۱۸","","",1,""]],"r":[],"no":1,"nr":0},"چاپ جهارم1337":{"n":"چاپ جهارم۱۳۳۷","o":[[210018,"ترجمه و نگارش بهروز","چاپ جهارم۱۳۳۷","","",1,"1337"]],"r":[],"no":1,"nr":0},"دکتر محسن فیاض":{"n":"دکتر محسن فیاض","o":[[224331,"راهنمای بیماری های شایع پوست و مو","دکتر محسن فیاض","","",1,""]],"r":[],"no":1,"nr":0},"مهدی قاسمی حسین سلیمانی":{"n":"مهدی ق