لوسی و مجیزگویی از او موفق هستند، قلمرو پادشاهیِ خود را به آن ها می بخشد و باعث می شود عواقب تراژیک و غم انگیزی برای کل خانواده رقم بخورد. این نمایشنامه که از ماجرای اسطوره ایِ پادشاهی سلتیک به نام «لیرِ بریتانیا» گرفته شده، مورد اقتباس های بی شماری در تئاتر و سینما قرار گرفته و وظیفه ی اجرای نقش اصلی آن، به برترین و موفق ترین بازیگران هنرهای نمایشی سپرده شده است. شکسپیر در این اثر، عاطفه، بی رحمی، حمایت، غرور، خِرد و ضعف ان","","",1,"1403"]],"r":[],"no":1,"nr":0},"نیکزاد نورپناه":{"n":"نیکزاد نورپناه","o":[[128091,"ناپدیدشدن","نیکزاد نورپناه","","",1,""]],"r":[[82163,"آخرین گرگ","لاسلو کراسناهورکای","نیکزاد نورپناه","",2,"2019"]],"no":1,"nr":1},"عبدالرحمن بن احمد جامی":{"n":"عبدالرحمن بن احمد جامی","o":[[83670,"نفحات الانس","عبدالرحمن بن احمد جامی","","",7,"1395"]],"r":[],"no":1,"nr":0},"علامه حسن زاده املی":{"n":"علامه حسن زاده آملی","o":[[84997,"رساله رموز و کنوز","علامه حسن زاده آملی","","",1,""]],"r":[],"no":1,"nr":0},"تحلیل شخصیت ها در مثنوی":{"n":"تحلیل شخصیت ها در مثنوی","o":[[85291,"دلیل آفتاب","تحلیل شخصیت ها در مثنوی","","",1,""]],"r":[],"no":1,"nr":0},"سیدجعفر سجادی":{"n":"سیدجعفر سجادی‌‌","o":[],"r":[[87459,"اندیشه‌های اهل مدینه فاضله","ابونصر محمد فارابی","سیدجعفر سجادی‌‌","",1,"1379"]],"no":0,"nr":1},"گروهی از ایران شناسان":{"n":"گروهی از ایران شناسان","o":[[87505,"تاریخ ادبیات فارسی","گروهی از ایران شناسان","مجدالدین کیوانی","نخست : مقدمه ‌ای کلی بر ادبیات فارسی",1,"1393"]],"r":[],"no":1,"nr":0},"انا ماریا ماتوته":{"n":"آنا ماریا ماتوته","o":[[88068,"پولینا","آنا ماریا ماتوته","محمد قاضی","",1,""]],"r":[],"no":1,"nr":0},"توماس ریچارد مایلز":{"n":"توماس ریچارد مایلز","o":[[88303,"تجربه دینی","توماس ریچارد مایلز","جابر اکبری","",4,"1380"],[226573,"تجربه ی دینی","توماس ریچارد مایلز","جابر اکبری","",1,"1380"]],"r":[],"no":2,"nr":0},"هایدی روزن باوم":{"n":"هایدی روزن باوم","o":[[88602,"خانواده به منزله ساختاری در مقابل جامعه","هایدی روزن باوم","محمدصادق مهدوی","",3,"1402"]],"r":[],"no":1,"nr":0},"غ وحید مازندرانی":{"n":"غ. وحید مازندرانی","o":[],"r":[[887