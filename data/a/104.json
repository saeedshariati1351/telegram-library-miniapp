یص کار خود مواجه می‌شود. چون هیچ تلاشی بی‌اشتباه و کاستی نیست؛ ولی کسی که تلاش می‌کند، کسی که اشتیاق را می‌شناسد، کسی که ایثار می‌کند و خود را وقف هدفی والا می‌سازد، همان کسی است که در بهترین حالت طعم پیروزی را بیش از دیگران می‌چشد و در بدترین حالت و در صورت شکست، حداقل پر دل و جرئت، شکست می‌خورد","","",1,""]],"r":[],"no":1,"nr":0},"منوچهر سرخابی":{"n":"منوچهر سرخابی","o":[[253498,"جملات کلیدی زبان انگلیسی","منوچهر سرخابی","","",1,"1377"]],"r":[],"no":1,"nr":0},"سنت موسیقی کلاسیک":{"n":"سنت موسیقی کلاسیک","o":[[254047,"آرنولد شوئنبرگ و تکامل","سنت موسیقی کلاسیک","","",1,""]],"r":[],"no":1,"nr":0},"پایه تا حرفه ایی":{"n":"پایه تا حرفه ایی","o":[[255136,"اصول هنر طراحی لباس","پایه تا حرفه ایی","","",1,""]],"r":[],"no":1,"nr":0},"دکتر جواد وحیدی":{"n":"دکتر جواد وحیدی","o":[[256337,"اموزش گام به گام برنامه نویسی پایتون","دکتر جواد وحیدی","","",1,""]],"r":[],"no":1,"nr":0},"سید علی میرعشقی":{"n":"سید علی میرعشقی","o":[[256437,"مبانی الکترونیک میرعشقی جلد دوم ویرایش ۲","سید علی میرعشقی","","دوم",1,"1389"]],"r":[],"no":1,"nr":0},"دکتر مالک نژاد":{"n":"دکتر مالک نژاد","o":[[256608,"محاسبات عددی","دکتر بابلیان و دکتر مالک نژاد","","",2,"1367"]],"r":[],"no":1,"nr":0},"چارلز مورتیمر":{"n":"چارلز مورتیمر","o":[[257047,"شیمی عمومی ۱","چارلز مورتیمر","عیسی یاوری","",1,"1375"]],"r":[],"no":1,"nr":0},"مجتبی شربتی":{"n":"مجتبی شربتی","o":[[257067,"آشنایی با علوم و معارف دفاع مقدس","هادی مراد پیری و مجتبی شربتی","","",1,"1393"]],"r":[],"no":1,"nr":0},"سفر بانویی در طریقت معرفت یاکی":{"n":"سفر بانویی در طریقت معرفت یاکی","o":[[258568,"گذر ساحران","سفر بانویی در طریقت معرفت یاکی","","",1,""]],"r":[],"no":1,"nr":0},"1490 منتخبات زرین شعر فارسی":{"n":"۱۴۹۰- منتخبات زرین شعر فارسی","o":[[267403,"1490- A Golden Treasury Of Persian Poetry","۱۴۹۰- منتخبات زرین شعر فارسی","","",1,""]],"r":[],"no":1,"nr":0},"تامس ا هربس":{"n":"تامس آ.هربس","o":[[268234,"وضعیت آخر","تامس آ.هربس","","",1,""]],"r":[],"no":1,"nr":0}}