انی","پاراگراف‌نویسی، کتاب حاضر جلد دوم از مجموعۀ نگارش دانشگاهی است که به آموزش اصول و روش‌های نگارش مقالات کوتاهِ عمومی اختصاص دارد. این کتاب که در نوع خود بی‌نظیر است، مبتنی بر اصول رتوریک، در بخش اول و دوم، ساختمان و انواع مقالات کوتاه را به شکلی ساده و کاربردی همراه با مثال‌های متعدد تشریح می‌کند. در بخش سوم نیز نشان داده می‌شود چطور می‌توان مقالات کوتاه را بسط داده، به سوی مقالات طولانی‌تر حرکت کرد. داستان‌نویسی و ادبیات نمایشی را که کنار بگذرایم، این کتاب در همۀ انواع دیگر نگارش از جملۀ نگارش علمی و دانشگاهی، نگارش ژورنالیستی، گزارش‌نویسی، نقدنویسی و همۀ انواع نگارش عمومی ک","","",5,"1400"]],"r":[],"no":1,"nr":0},"رامین حاجیان فرد":{"n":"رامین حاجیان فرد","o":[[161330,"رویکردی نو به آهنگسازی","رامین حاجیان فرد","","",2,""]],"r":[],"no":1,"nr":0},"ادبیات افغان":{"n":"ادبیات افغان","o":[[164824,"رهنورد زریاب","ادبیات افغان","","",1,""]],"r":[],"no":1,"nr":0},"دکتر ارین قلی پور":{"n":"دکتر آرین قلی پور","o":[[165061,"خلاصه کتاب رفتار سازمانی","دکتر آرین قلی پور","","",1,""],[165063,"مدیریت منابع انسانی","دکتر آرین قلی پور","","",1,""]],"r":[],"no":2,"nr":0},"خانم دکتر مشیرزاده":{"n":"خانم دکتر مشیرزاده","o":[[167321,"خلاصه تحول در نظریه های روابط بین الملل","خانم دکتر مشیرزاده","","",1,""]],"r":[],"no":1,"nr":0}}