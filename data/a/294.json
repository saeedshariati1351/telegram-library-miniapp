برد","سی اس لوییس کلایو استیپلز لوییس؛ تیرین» ، آخرین پادشاه نارنیا ، زمانی که با خبر شد اصلان در آن نزدیکی دیده شده است بسیار خوشحال شد، اما به وسیلۀ موجودی به نام « قنطورس» که نیمه انسان و نیمه اسب بود، باخبر گردید که اسلان در آن‌جا نیست، زیرا ستاره‌ها دارای ترکیب خوبی نبوده‌اند؛ شاه تیرین در حالی که مشغول نجات حیوانات و درختان از دست اذیت و آزار کالرمن‌ها، که به نام اسلان این اعمال را انجام می‌دادند، بود، به وسیلۀ آن‌ها دستگیر و گرفتار شد و او را نزد شیفت که موجودی بین میمون و انسان بود ، بردند؛ شیفت او را به درختی بست تا از گرسنگی بمیرد. شاه تیرین در حالت بیهوشی، خود را میان لیدی مولی و لرد دیگوری دید و","","",1,"1379"]],"r":[],"no":1,"nr":0},"دکتر علی مراد داود":{"n":"دکتر علی مراد داود","o":[[255042,"عقل در حکمت مشاء","دکتر علی مراد داود","","",1,"1387"]],"r":[],"no":1,"nr":0},"منوچهر انور":{"n":"منوچهر انور","o":[],"r":[[255269,"Pakhtestan","","منوچهر انور","",1,""]],"no":0,"nr":1},"مقیمی":{"n":"مقیمی","o":[[256019,"فصل ٣ زمینه ها و بسترهای مدیریت","مقیمی","","",1,""]],"r":[],"no":1,"nr":0},"به پشتیبانی پیام دهید":{"n":"به پشتیبانی پیام دهید","o":[[267681,"رستاخیز مردگان","به پشتیبانی پیام دهید","","",1,""],[267693,"معرفی شده در ریلز اخر اینستاگرامم","به پشتیبانی پیام دهید","","",1,""],[267728,"فایل رایگان کتب ممنوع علوم غریبه","به پشتیبانی پیام دهید","","",1,""],[267734,"(The Book of Wisdom)","به پشتیبانی پیام دهید","","",1,""],[267744,"کلید گمشده سلیمان اثری پررمز و راز است که خواننده را به دنیای تاریک جادو و احضار موجودات ماورایی می‌برد. روایت، بر پایه قدرت‌هایی شکل گرفته که با ذهن منطقی سازگار نیستند و همین تعلیق، مخاطب را درگیر می‌سازد. میان سطور، نشانه‌هایی از تاریخ، اسطوره و باورهای فراموش‌شده پنهان شده که درک آن‌ها نیاز به دقت بالا دارد. کتاب مدعی افشای اسراری است که قرن‌ها توسط فرقه‌ها و جادوگران پنهان مانده‌اند. همین ادعاها، مرز میان واقعیت و توهم را چنان تیره می‌کنند که خواننده نمی‌داند در حال کشف حقیقت است یا افتادن در دام فریب","به پشتیبانی پیام دهید","","",1,""],[267753,"کتابهای نایاب درباره امام حسین","به پشتیبانی پیام دهید","","",1,""],[267755