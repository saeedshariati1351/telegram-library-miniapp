ب حاضر جلد دوم از مجموعۀ نگارش دانشگاهی است که به آموزش اصول","o":[[160727,"نوشته سیدعلی اصغر سلطانی","پاراگراف‌نویسی، کتاب حاضر جلد دوم از مجموعۀ نگارش دانشگاهی است که به آموزش اصول و روش‌های نگارش مقالات کوتاهِ عمومی اختصاص دارد. این کتاب که در نوع خود بی‌نظیر است، مبتنی بر اصول رتوریک، در بخش اول و دوم، ساختمان و انواع مقالات کوتاه را به شکلی ساده و کاربردی همراه با مثال‌های متعدد تشریح می‌کند. در بخش سوم نیز نشان داده می‌شود چطور می‌توان مقالات کوتاه را بسط داده، به سوی مقالات طولانی‌تر حرکت کرد. داستان‌نویسی و ادبیات نمایشی را که کنار بگذرایم، این کتاب در همۀ انواع دیگر نگارش از جملۀ نگارش علمی و دانشگاهی، نگارش ژورنالیستی، گزارش‌نویسی، نقدنویسی و همۀ انواع نگارش عمومی ک","","",5,"1400"]],"r":[],"no":1,"nr":0},"شهرام زرندار":{"n":"شهرام زرندار","o":[],"r":[[161168,"شوان‌ها","انوره دو بالزاک","شهرام زرندار","",3,"1373"]],"no":0,"nr":1},"tarikh tabari 05":{"n":"Tarikh tabari 05","o":[[163096,"5","Tarikh tabari 05","","",3,""]],"r":[],"no":1,"nr":0},"استفان فوکونی":{"n":"استفان فوکونی","o":[[165119,"پیرمردی در سقف","توماس آندرسون، استفان فوکونی","","",1,""]],"r":[],"no":1,"nr":0}}