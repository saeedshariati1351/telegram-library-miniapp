ی می‌داند .وی همچنین به این نتیجه می‌رسد که نظام اداری هخامنشی‌ها در جهت جلب رضایت اتباع آنها بوده است نه فشار و نارض","همایون صنعتی‌زاده","",1,"1379"],[202603,"سرزمینهای زیر فرمان هخامنشیان","","همایون صنعتی زاده","",2,""],[211231,"شکوهمندی شهر ایرانی در قرون وسطی","دانشنامه فارس،چاپ نخست۱۳۸۶","همایون صنعتی زاده","",1,"1386"],[215478,"شکوهمندی شهر ایرانی در قرون وسطی","","همایون صنعتی زاده","",1,""],[226699,"جغرافیای استرابو","","همایون صنعتی زاده","",1,""],[230289,"جغرافیای استرابو: سرزمین های زیر فرمان هخامنشیان","استرابون","همایون صنعتی زاده","",2,"1382"],[231151,"(۵۳۱): چکیده تاریخ کیش زرتشت","مری بویس","همایون صنعتی زاده","",1,"1377"]],"no":1,"nr":14},"مهرداد نبیعی":{"n":"مهرداد نبیعی","o":[],"r":[[572,"جواهرات سلطنتی ایران","وی .بی. مین و ای.دی. تشنگام","مهرداد نبیعی","",2,""]],"no":0,"nr":1},"دیوید استفن پاورز":{"n":"دیوید استفن پاورز","o":[[919,"قرآن و محیط شرعی آن","دیوید استفن پاورز","","",1,""]],"r":[],"no":1,"nr":0},"محمدجعفر خورموجی":{"n":"محمدجعفر خورموجی","o":[[1706,"تاریخ قاجار","محمدجعفر خورموجی","","",10,"1344"]],"r":[],"no":1,"nr":0},"کاظم کاظم زاده":{"n":"کاظم کاظم زاده","o":[],"r":[[2006,"مطالعاتی درباره‌ ساسانیان","کنستانتین اینوسترانتسف","کاظم کاظم زاده","",6,""],[11006,"مطالعاتی درباره‌ی ساسانیان","کنستانتین اینوسترانتسف","کاظم کاظم زاده","",2,""],[49395,"عید بهار ساسانیان","کنستانتین اینو سترانتسف","کاظم کاظم زاده","",6,""],[225489,"مطالعاتی دربارهٔ ساسانیان","کنستانتین اینو سترانتسف","کاظم کاظم زاده","",1,""]],"no":0,"nr":4},"دکتر هادی هدایتی":{"n":"دکتر هادی هدایتی","o":[[10066,"کوروش کبیر","دکتر هادی هدایتی","","",3,""]],"r":[[2240,"تاریخ هرودت","هرودوت، ۴۸۵؟ - ۴۲۵؟ ق.م.","دکتر هادی هدایتی","",4,"1383"],[88730,"تاریخ هرودت","هرودوت، ۴۸۵؟ - ۴۲۵؟ ق.م.","دکتر هادی هدایتی","پنجم : ترپسیکور جلد ششم : اراتو",3,"1383"],[88731,"تاریخ هرودت","هرودوت، ۴۸۵؟ - ۴۲۵؟ ق.م.","دکتر هادی هدایتی","چهارم : ملپومن",3,"1383"],[88732,"تاریخ هرودت","هرودوت، ۴۸۵؟ - ۴۲۵؟ ق.م.","دکتر هادی هدایتی","سوم : تالی",3,"1383"],[88733,"تاریخ هرودت","هرودوت، ۴۸۵؟ - ۴۲۵؟ ق.م