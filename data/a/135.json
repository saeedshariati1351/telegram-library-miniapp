ت نگران این قضیه بود به پیشنهاد شهرزاد وی را به عقد پادشاه درمی‌آورد","عبداللطیف طسوجی، مجموعه‌ای از افسانه‌ها و قصه‌های قدیم ایران و هند و سرزمین‌های عربی است که در آن، احوال و آداب و رسوم مردم ایران و هند و عرب آمده و سرشار از حکایت‌های آموزنده و نکات پندآموز و اخلاقی است","","",1,""]],"r":[],"no":1,"nr":0},"یکی از بازاریان سنتی تهران":{"n":"یکی از بازاریان سنتی تهران","o":[[204648,"حاجی آقا","صادق هدایت؛ حاجی آقا داستان بلندی از صادق هدایت است که در ۱۳۲۴ خورشیدی توسط انتشارات مجلهٔ سخن در تهران منتشر شد. این داستان در زمان جنگ جهانی دوم اتفاق می‌افتد و محوریت آن بر شخصی به نام حاجی آقا، یکی از بازاریان تهران است. نحو بیان داستان از دیدگاه سوم شخص است. داستان آن در پیش و پس از اشغال ایران توسط متفقین در جنگ جهانی دوم، روی می‌دهد و شخصیت اصلی آن، یکی از بازاریان سنتی تهران، حاجی ابوتراب است که هدایت مجموعه‌ای از زشتی‌های اخلاقی را در وجود او قرار داده است","","",1,"1324"]],"r":[],"no":1,"nr":0},"جیو کیلو":{"n":"جیو کیلو","o":[[206693,"انقلاب ناتمام سون یاتسن و مبارزه برای چین مدرن","جیو کیلو","","",2,""]],"r":[],"no":1,"nr":0},"نقدی بر اندیشه های روشنفکران دینی":{"n":"نقدی بر اندیشه‌های روشنفکران دینی","o":[[207247,"اندیشه‌های سترون","نقدی بر اندیشه‌های روشنفکران دینی","","",1,""]],"r":[],"no":1,"nr":0},"نشرروزبهان":{"n":"نشرروزبهان","o":[[209306,"ترجمه میرمجید خلخالی زاویه","نشرروزبهان،چاپ اول۱۳۷۸","","",1,"1378"],[210200,"ترجمه ایرج زهری","نشرروزبهان،چاپ اول۱۳۶۱","","",1,"1361"],[210671,"ترجمه علیرضا توکلی صابری","نشرروزبهان،چاپ اول۱۳۶۱","","",1,"1361"],[210692,"ترجمه مهرداد پارسا","نشرروزبهان،چاپ اول۱۳۸۹","","",1,"1389"]],"r":[],"no":4,"nr":0},"author realsmart":{"n":"Author Realsmart","o":[[209566,"Hindu Gods and Goddesses","Author Realsmart","","",1,""]],"r":[],"no":1,"nr":0},"چاپ سوم1371":{"n":"چاپ سوم۱۳۷۱","o":[[210532,"عجیب ترین کتابی که تاکنون خوانده اید","نشر پیک فرهنگ، چاپ سوم۱۳۷۱","سیروس گنجوی","",1,"1371"]],"r":[],"no":1,"nr":0},"امام چ احمد میبدی":{"n":"امام چ احمد میبدی","o":[[218822,"خلاصه کشف الاسرار ده جلدی خواجه عبدالله انصاری","امام چ احمد میبدی