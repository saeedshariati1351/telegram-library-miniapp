رضاشاه پهلوی؛ سفرنامه خوزستان در سال 1303 هجری خورشیدی مصادف با 1924 میلادی نوشته شده است و یکی از مهم ترین رویدادهای تاریخ صد سال گذشته ایران را گام به گام دنبال می کند. سفرنامه مازندران، در سال 1305 یک سال پس از پادشاهی رضا شاه نوشته شده است. آن دو سفرنامه در همان زمانها انتشار محدودی یافت و نایاب بود، تا در اواخر پادشاهی محمد رضا شاه به مناسبت \"آئین ملی بزرگداشت پادشاهی پهلوی\" (1354، 1975م) از سوی مرکز پژوهش و نشر فرهنگ سیاسی دوران پهلوی بار دیگر منتشر شدند و در سال 1383 توسط \"نشر تلاش\" در خارج کشور تجدید چاپ گردید","","",2,"1303","مرکز پژوهش و نشر فرهنگ سیاسی دوران پهلوی","9",32]],"r":[],"no":1,"nr":0},"الهه روح الهی روح الهی":{"n":"الهه روح الهی روح الهی","o":[[201514,"معرفی ساختار آب‌رسانی و چرخۀ آب در کاخ عالی قاپوی اصفهان","الهه روح الهی روح الهی؛ علی شجاعی اصفهانی؛ سعید قاسمی نژاد","","",1,"","","",33]],"r":[],"no":1,"nr":0},"رسول وطن دوست":{"n":"رسول وطن‌دوست","o":[],"r":[[202527,"(۳۵۴۲): حفاظت، نگهداری و مرمت آثار هنری و تاریخی (درمان، مرمت و بازسازی)","هارولد.ج پلندرلیت، ا.ی.ا ورنر","رسول وطن‌دوست","",1,"1376","دانشگاه‌ هنر","7",33]],"no":0,"nr":1},"فرزاد استرکی":{"n":"فرزاد آسترکی","o":[[202863,"(۳۴۸۰): گزارش های اولیه از نقش برجسته اواخر دوره اشکانی یا اوایل ساسانی در پنج علی، نقش برجسته اشکانی در اندیکا و بررسی شمشیرها و خنجرهای اواخر دوره اشکانی (لاتین)","کاوه فرخ، غلامرضا کرمیان، میثم دلفان، فرزاد آسترکی","","",1,"","","",33]],"r":[],"no":1,"nr":0},"فاطمه کاتب":{"n":"فاطمه کاتب","o":[[203364,"(۳۳۸۰): قالی در منابع مکتوب قرون چهارم تا هشتم هجری قمری","اکرم نوری، فاطمه کاتب، علی خلیقی","","",1,"","","",33]],"r":[],"no":1,"nr":0},"در مسیر خود با دیدگاه هایی مانند نسبی گرایی":{"n":"در مسیر خود با دیدگاه‌هایی مانند نسبی‌گرایی","o":[[204873,"در دفاع از واقع‌گرایی اخلاقی","آیا خوب و بد، درست و نادرست، واقعیت‌هایی مستقل از سلیقه، قرارداد و باور ما هستند، یا اخلاق چیزی است که خود انسان‌ها می‌سازند؟ نویسنده با ورود به قلب مباحث فرااخلاق، از واقع‌گرایی اخلاقی دفاع می‌کند و در مسیر خود با دیدگاه‌هایی مانند نسبی‌گرایی، ذهن‌گرایی و نظریه‌های غیرشناخت‌گرایانه به گفت‌وگو و جدال می‌پردازد؛ اما جذابیت کتاب فقط در دفاع از یک موضع فلسفی نیست، بلکه در پرسش‌هایی است که مستقیماً به تجربه اخلاقی ما مربوط می‌شوند: اگر حقیقت اخلاقی وجود دارد، چگونه می‌توانیم آن را بشناسیم؟ چرا باید به آن عمل کنیم؟ آیا اختلاف‌نظرهای عمیق اخلاقی واقع‌گرایی را زیر سؤال می‌برند؟ و آیا علم تنها معیار شناخت واقعیت است؟ این کتاب که ساختاری نظام‌من","","",1,"","","",38]],"r":[],"no":1,"nr":0},"کتابی برای کسانی که می خواهند از پشت صحنه تحولات فکری یکی از مهم ترین دوره های گذار تاریخ اروپا سر دربیاورند":{"n":"کتابی برای کسانی که می‌خواهند از پشت صحنه تحولات فکری یکی از مهم‌ترین دوره‌های گذار تاریخ اروپا سر دربیاورند","o":[[204905,"رساله قوانین","فیلسوف برجسته اواخر بیزانس، کتابی برای کسانی که می‌خواهند از پشت صحنه تحولات فکری یکی از مهم‌ترین دوره‌های گذار تاریخ اروپا سر دربیاورند؛ اثری که در آن فلسفه نوافلاطونی، سیاست، قانون، دین و رؤیای بازسازی نظم اجتماعی درهم می‌آمیزند. آنچه امروز از این اثر در دست داریم، بخش‌هایی برجامانده از رساله‌ای بزرگ‌تر است که در قرن نوزدهم با جست‌وجو و مقابله نسخه‌های خطی گردآوری و منتشر شده و مقدمه مفصل کتاب نیز زندگی و اندیشه پلتون و تلاش او برای احیای نوعی نظام دینی و اخلاقی بر پایه میراث یونان باستان را بررسی می‌کند. این کتاب می‌تواند فرصتی جذاب باشد تا با اندیشمندی آشنا شود که در مرز میان جهان مسیحی، میراث یونانی و اندیشه سیاسی قرار گرفته و پرسش‌هایی ماندگار درباره قانون، جامعه، دی","","",1,"","","l",38]],"r":[],"no":1,"nr":0},"انتشارات ناقوس":{"n":"انتشارات ناقوس","o":[[210620,"ترجمه مسعود کاویانی","انتشارات ناقوس، چاپ اول۱۳۹۸","","",1,"1398","","",39]],"r":[],"no":1,"nr":0},"با اضافات داود منشی زاده":{"n":"با اضافات داود منشی زاده","o":[],"r":[[211496,"پژوهش ژوزف مارکوارت آلمانی","","با اضافات داود منشی زاده","",1,"1368","","",39]],"no":0,"nr":1},"مراحل اساسی سیر اندیشه در جامعه شناسی":{"n":"مراحل اساسی سیر اندیشه در جامعه‌‌شناسی","o":[[224578,"کتابخانه جامعه شناسی فلسفه روانشناسی","مراحل اساسی سیر اندیشه در جامعه‌‌شناسی","باقر پرهام","",1,"","","",40]],"r":[],"no":1,"nr":0},"طیبه بخشنده":{"n":"طیبه بخشنده","o":[],"r":[[226