جمه شده است. ترجمه انگلیسی این کتاب توسط Annette Susannah Beveridge انجام شده است","ویژگی‌های مهم کتاب","","",1,""],[251986,"\"Travels in the Mogul Empire, A.D. 1656-1668\" نوشته François Bernier یکی از مهم‌ترین سفرنامه‌های قرن هفدهم میلادی است. این کتاب برای اولین بار در سال 1670-71 به زبان فرانسوی منتشر شد و بعدها به انگلیسی ترجمه شد. این کتاب به سفرهای نویسنده به امپراتوری مغول در هند در سال‌های 1656 تا 1668 می‌پردازد و شامل توصیفاتی دقیق از مناظر، فرهنگ و مردم هند در آن زمان است","ویژگی‌های مهم کتاب","","",1,""],[251988,"\"Travels in Persia, 1627-1629\" نوشته Thomas Herbert یکی از مهم‌ترین سفرنامه‌های قرن هفدهم میلادی است. این کتاب برای اولین بار در سال 1928 منتشر شد و به سرعت محبوبیت زیادی پیدا کرد. این کتاب به سفرهای نویسنده به ایران در سال‌های 1627 تا 1629 می‌پردازد و شامل توصیفاتی دقیق از مناظر، فرهنگ و مردم ایران در آن زمان است","ویژگی‌های مهم کتاب","","",1,"1928"]],"r":[],"no":5,"nr":0},"چشم انداز اینده ان":{"n":"چشم انداز آینده آن","o":[[254936,"زبان شناسی تاریخی و","چشم انداز آینده آن","","",1,""]],"r":[],"no":1,"nr":0},"عبدالواحد انصاری":{"n":"عبدالواحد انصاری","o":[[255279,"ده فضیلت خلق نیکو","عبدالواحد انصاری","","",1,""]],"r":[],"no":1,"nr":0},"1224139":{"n":"۱۲۲۴۱۳۹","o":[[257783,"کد درس","۱۲۲۴۱۳۹","","",1,"بروز شده تا تابستان 97"]],"r":[],"no":1,"nr":0},"انتشارات ارشد":{"n":"انتشارات ارشد","o":[[257809,"فارسی آنالیز عددی 1","انتشارات ارشد","","",1,""]],"r":[],"no":1,"nr":0},"مهدی خردمند":{"n":"مهدی خردمند","o":[[258153,"افزایش قدرت اراده در ۷ روز یا کمتر","مهدی خردمند","","",1,""]],"r":[],"no":1,"nr":0},"میگل د":{"n":"میگل د.","o":[[259064,"دون کیشوت","سروانتس‌، میگل د.، ۱۵۴۷ - ۱۶۱۶ م.","محمد قاضی","",1,"1397"]],"r":[],"no":1,"nr":0}}