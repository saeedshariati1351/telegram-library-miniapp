 تن از سه دخترش در چاپلوسی و مجیزگویی از او موفق هستند، قلمرو پادشاهیِ خود را به آن ها می بخشد و باعث می شود عواقب تراژیک و غم انگیزی برای کل خانواده رقم بخورد. این نمایشنامه که از ماجرای اسطوره ایِ پادشاهی سلتیک به نام «لیرِ بریتانیا» گرفته شده، مورد اقتباس های بی شماری در تئاتر و سینما قرار گرفته و وظیفه ی اجرای نقش اصلی آن، به برترین و موفق ترین بازیگران هنرهای نمایشی سپرده شده است. شکسپیر در این اثر، عاطفه، بی رحمی، حمایت، غرور، خِرد و ضعف ان","","",1,"1403"]],"r":[],"no":1,"nr":0},"انتشارات امیرکبیر":{"n":"انتشارات امیرکبیر","o":[[84566,"دکتر سید حسن صفوی","۱۳۶۴, انتشارات امیرکبیر","","",1,""],[151304,"جهان سوم","انتشارات امیرکبیر","ر. فربد","",1,""],[171841,"تصحیح","انتشارات امیرکبیر، چاپ دوم۱۳۹۳","","",2,"1393"],[207425,"ترجمه اردشیر نیک پور","انتشارات امیرکبیر، ۱۳۴","","",1,""],[207521,"ترجمه مصطفی مفیدی","انتشارات امیرکبیر، ۲۵۳۶شاهنشاهی","","",1,""],[207592,"ترجمه دکتر حسن هنرمندی","انتشارات امیرکبیر،چاپ اول۱۳۳۴","","",1,"1334"],[207718,"ازکوبیسم تا پاپ آرت","انتشارات امیرکبیر، چاپ دوم ۲۵۳۶","","",1,""],[207719,"از امپرسیونیسم تا کوبیسم","انتشارات امیرکبیر، چاپ دوم ۲۵۳۶","","",1,""],[207867,"ترجمه فریدون بدره ای","انتشارات امیرکبیر،چاپ سوم۲۵۳۶شاهنشاهی","","",1,""],[208213,"ترجمه حسن انوشه","انتشارات امیرکبیر، چاپ اول۱۳۷۰","","",1,"1370"],[208252,"تحقیق و نگارش حسین نوربخش","انتشارات امیرکبیر، چاپ اول۱۳۶۹","","",1,"1369"],[208507,"تصحیح و تحشیه منصور رستگار فسائی","انتشارات امیرکبیر، چاپ اول۱۳۷۷","","",2,"1377"],[209032,"ترجمه ابوالقاسم حالت","انتشارات امیرکبیر، چاپ دوم۱۳۸۰","","",1,"1380"],[209076,"ترجمه محمد مربوط","انتشارات امیرکبیر، چاپ اول۱۳۴۳","","",1,"1343"],[209276,"به کوشش‌ ناصرالدین شاه حسینی","انتشارات امیرکبیر،چاپ چهارم۱۳۶۴","","",1,"1364"],[209403,"پژوهشی در بنیاد سوسیالیسم و لیبرالیسم","انتشارات امیرکبیر، چاپ اول۱۳۵۷","علی رامین","",1,"1357"],[209471,"به اهتمام لیما صالح رامسری","انتشارات امیرکبیر، چاپ اول۱۳۶۰","","",1,"1360"],[209591,"به کوشش‌ دکتر جعفر شعار","انتشارات امیرکبیر،چاپ سوم۱۳۶۳","","",1,"1363"],[209731,"به روایت شیخ صدوق","انتشارات