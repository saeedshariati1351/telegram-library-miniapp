,1,"","","",33]],"r":[],"no":1,"nr":0},"stephen markel":{"n":"Stephen Markel","o":[[201428,"فلزکاری مغول و جنوب آسیا در آغاز دوران مدرن (موزة ایالتی هنر لس‌آنجس LACMA)","Stephen Markel","","",1,"","","",33]],"r":[],"no":1,"nr":0},"مرتضی مجیدی":{"n":"مرتضی مجیدی","o":[[201516,"ارزیابی محله‌های بافت تاریخی باغ‌شهر خوانسار از نظر پایداری کالبدی (مورد مطالعه: محلۀ پُلِگوش)","بابک عالمی؛ مرتضی مجیدی","","",1,"","","",33]],"r":[],"no":1,"nr":0},"البوم تاریخی رجال ایران":{"n":"آلبوم تاریخی رجال ایران","o":[[202600,"آلبوم تاریخی‌ای از تصاویر رجال ایران در دوره قاجار توسط «آرشیو اسمیتسون» منتشر شده است. براساس نوشته‌ها به نظر می‌رسید این آلبوم مربوط به خانواده «یارافشار» و به طور مشخص «پرویز یارافشار، سناتور و نماینده مجلس شورای ملی» باشد. با این‌حال اسمیتسون در انتشار این آلبوم به مالکیت آن اشاره‌ای نکرده است. این آلبوم تصاویر جالبی دارد که صاحب آن، نام رجال را با دست خط خود کنار آنها نوشته است","آلبوم تاریخی رجال ایران","","",1,"","","",33]],"r":[],"no":1,"nr":0},"اذر1343":{"n":"آذر۱۳۴۳","o":[[203055,"آثار تاریخی و اماکن باستانی فارس","آذر۱۳۴۳","","",2,"","","",33]],"r":[],"no":1,"nr":0},"نسرین فقیه":{"n":"نسرین فقیه","o":[[203616,"(۲۱۶): بندر سیراف؛ شکلبندی شهر ایرانی در صدر اسلام","نسرین فقیه","","",1,"","","",33]],"r":[],"no":1,"nr":0},"حتی معنای انسان بودن را دگرگون کرده است نویسنده با تحلیل جریان هایی چون مارکسیسم":{"n":"حتی معنای انسان بودن را دگرگون کرده است. نویسنده با تحلیل جریان‌هایی چون مارکسیسم","o":[[204975,"عصر سکولاریزاسیون","یکی از مهم‌ترین متفکران سیاسی و فلسفی ایتالیا که تلاشی ژرف برای فهم ریشه‌های بحران معنوی و فرهنگی جهان مدرن است. نویسنده با نگاهی تاریخی و فلسفی نشان می‌دهد که سکولاریزاسیون صرفاً جدایی دین از سیاست نیست، بلکه فرآیندی عمیق است که شیوه اندیشیدن، اخلاق، فرهنگ و حتی معنای انسان بودن را دگرگون کرده است. نویسنده با تحلیل جریان‌هایی چون مارکسیسم، تکنوکراسی، جامعه مصرفی، انقلاب‌های فرهنگی دهه ۱۹۶۰ و نسبت مسیحیت با مدرنیته، خواننده را به بازاندیشی درباره سرنوشت تمدن غرب و آینده ارزش‌های انسانی دعوت می‌کند. کتاب برای علاقه‌مندان فلسفه، الهیات، ا