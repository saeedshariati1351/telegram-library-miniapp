کند. کتاب برای علاقه‌مندان فلسفه، الهیات، اندیشه سیاسی و نقد مدرنیته، اثری تأمل‌برانگیز و الهام‌بخش است که بسیاری از پرسش‌های امروز را از منظری متفاوت و عمیق بررسی می‌کند","","",1,""]],"r":[],"no":1,"nr":0},"ماجرای یک جنگ ایدیولوژیک":{"n":"ماجرای یک جنگ ایدئولوژیک","o":[[205511,"ضد فاشیسم","ماجرای یک جنگ ایدئولوژیک","","",1,""]],"r":[],"no":1,"nr":0},"جان بی مورال":{"n":"جان بی. مورال","o":[[205689,"اندیشه سیاسی در اروپای سده‌‌های میانه","جان بی. مورال","","",1,"1399"]],"r":[],"no":1,"nr":0},"چاپخانه ندا":{"n":"چاپخانه ندا","o":[[208059,"کهگیلویه و بویراحمد","چاپخانه ندا،تهران، چاپ اول۱۳۶۱","","",1,"1361"]],"r":[],"no":1,"nr":0},"چاپ دوم1390":{"n":"چاپ دوم۱۳۹۰","o":[[208438,"ترجمه علی اکبر فلاحی","انتشارات ققنوس، چاپ دوم۱۳۹۰","","",1,"1390"],[210358,"ترجمه مهدی غبرایی","نیکونشر،چاپ دوم۱۳۹۰","","",1,"1390"],[210682,"ترجمه ناهید احمدیان","نشرپرسش،چاپ دوم۱۳۹۰","","",1,"1390"]],"r":[],"no":3,"nr":0},"چاپ هشتم1392":{"n":"چاپ هشتم۱۳۹۲","o":[[208955,"ترجمه مصطفا عابدینی فرد","نشرذهن آویز،چاپ هشتم۱۳۹۲","","",1,"1392"]],"r":[],"no":1,"nr":0},"شما":{"n":"شما","o":[[209297,"ترجمه فاطمه السادات موسوی","انتشارات ما و شما،چاپ اول۱۳۹۱","","",1,"1391"]],"r":[],"no":1,"nr":0},"نشرسمیر":{"n":"نشرسمیر","o":[[210916,"ترجمه آرمانوش باباخانیانس","نشرسمیر،چاپ اول۱۳۹۵","","",1,"1395"]],"r":[],"no":1,"nr":0},"چاپ چهر":{"n":"چاپ چهر","o":[[211503,"ترجمه احمد بیانی","چاپ چهر،چاپ دوم۱۳۳۷","","",1,"1337"]],"r":[],"no":1,"nr":0},"چاپ چهارم1374":{"n":"چاپ چهارم۱۳۷۴","o":[[211520,"ترجمه مجید روشنگر","انتشارات علمی و فرهنگی،چاپ چهارم۱۳۷۴","","",1,"1374"]],"r":[],"no":1,"nr":0},"نشر جامی1387":{"n":"نشر جامی۱۳۸۷","o":[[211692,"به کوشش‌ امیر صاحبدل","نشر جامی۱۳۸۷","","",1,"1387"]],"r":[],"no":1,"nr":0},"نشرفلسفه1402":{"n":"نشرفلسفه۱۴۰۲","o":[[211754,"ترجمه عباس زیدی زاده","نشرفلسفه۱۴۰۲","","",1,"1402"]],"r":[],"no":1,"nr":0},"اوتار مهربابا":{"n":"اوتار مهربابا","o":[[218743,"هفتاد گل","اوتار مهربابا","","",1,""],[218744,"با دستان خدا","اوتار مهربابا","","",1,""]],"r":[],"no":2,"nr":0},"پل امیل اردمن":