دو تن از سه دخترش در چاپلوسی":{"n":"جنون می پردازد. شاه لیر به خاطر این که دو تن از سه دخترش در چاپلوسی","o":[[81762,"شاه لیر","کتاب شاه لیر، نمایشنامه ای تراژیک نوشته ی ویلیام شکسپیر است که در حدود سال 1605 میلادی به رشته ی تحریر درآمد. این نمایشنامه به سقوط تدریجی شخصیت اصلی داستان، شاه لیر، به سوی دیوانگی و جنون می پردازد. شاه لیر به خاطر این که دو تن از سه دخترش در چاپلوسی و مجیزگویی از او موفق هستند، قلمرو پادشاهیِ خود را به آن ها می بخشد و باعث می شود عواقب تراژیک و غم انگیزی برای کل خانواده رقم بخورد. این نمایشنامه که از ماجرای اسطوره ایِ پادشاهی سلتیک به نام «لیرِ بریتانیا» گرفته شده، مورد اقتباس های بی شماری در تئاتر و سینما قرار گرفته و وظیفه ی اجرای نقش اصلی آن، به برترین و موفق ترین بازیگران هنرهای نمایشی سپرده شده است. شکسپیر در این اثر، عاطفه، بی رحمی، حمایت، غرور، خِرد و ضعف ان","","",1,"1403"]],"r":[],"no":1,"nr":0},"احمد ابو محبوب":{"n":"احمد ابو محبوب","o":[[81816,"ساخت زبان فارسی","احمد ابو محبوب","","",1,""]],"r":[],"no":1,"nr":0},"احمد نیکو همت":{"n":"احمد نیکو همت","o":[[82740,"زندگی و آثار بهار","احمد نیکو همت","","",1,""]],"r":[],"no":1,"nr":0},"محمد علی مدرس تبریزی":{"n":"محمد علی مدرس تبریزی","o":[[84109,"دستور زبان فارسی","محمد علی مدرس تبریزی","","",3,"1388"]],"r":[],"no":1,"nr":0},"کارو با پیشگفتار ابوالقاسم صدارت":{"n":"کارو. با پیشگفتار ابوالقاسم صدارت","o":[[86370,"شکست سکوت","کارو. با پیشگفتار ابوالقاسم صدارت","","",1,""]],"r":[],"no":1,"nr":0},"روشن بینی جوانان":{"n":"روشن‌بینی جوانان","o":[[88852,"هربرت مارکوزه","روشن‌بینی جوانان و جنبش دانشجویی","","",2,""]],"r":[],"no":1,"nr":0},"هادی نجفی":{"n":"هادی نجفی","o":[[89227,"مؤمن در هزار حدیث","هادی نجفی","مصطفی اله‌دادی دستجردی","",4,"1400"]],"r":[],"no":1,"nr":0},"محمدعلی کریم زاده تبریزی":{"n":"محمدعلی کریم‌زاده تبریزی","o":[[90256,"یادواره شهر خوی","محمدعلی کریم‌زاده تبریزی","","",3,"2002"],[93590,"احوال و آثار نقاشان قدیم ایران","محمدعلی کریم‌زاده تبریزی","","سوم",2,""],[93591,"احوال و آثار نقاشان قدیم ایران","محمدعلی کریم‌زاده تبریزی","","دوم",2,""],[93592,"احوال و آثار نقاشان ق