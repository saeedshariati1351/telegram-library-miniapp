تکاب ترورهای سیاسی گردیده اند","o":[],"r":[[195911,"ترورهای تاریخ اثر‌ ژو. ترانشال با","","هادی خراسانی است ؛ کتاب حاضر گذشته از آن که ترورهای سیاسی تاریخ را به نحو زنده و گیرایی ترسیم می کند، دورنمایی از وقایع عمده تاریخی بسیاری از کشورها را ارائه می دهد، به طوریکه خواننده ضمن مطالعه این کتاب به تحولات تاریخی و اجتماعی کشورها از قبیل مبارزات استقلال طلبانه ملت ها – کشمکش های عقیدتی در قرون وسطی – بروز انقلابها منجمله انقلاب کبیر فرانسه و انقلاب روسیه – پیدایش افکار آنارشیستی با فاشیستی و امثال آن، آشنا می شود و به انگیزه های مختلف ترورهای سیاسی پی می برد و درمی یابد که چگونه عواملی از قبیل احساسات، دید ملی، تعصبات مذهبی، حس انتقام جویی و در مواردی علاقه به کسب شهرت موجب ارتکاب ترورهای سیاسی گردیده اند","",1,""]],"no":0,"nr":1},"by robert spencer":{"n":"by Robert Spencer","o":[[198682,"The History of Jihad From Muhammad to ISIS","by Robert Spencer","","",2,""]],"r":[],"no":1,"nr":0},"ارتور بایزر":{"n":"آرتور بایزر","o":[[198896,"مفاهیم فیزیک مدرن","آرتور بایزر","","",1,""]],"r":[],"no":1,"nr":0},"مهسا بدیعی قاسم غره داغی":{"n":"مهسا بدیعی قاسم غره داغی","o":[[199123,"سوزی","مهسا بدیعی قاسم غره داغی","","",1,""]],"r":[],"no":1,"nr":0},"بخامه ی فردریک تالبرگ":{"n":"بخامه ی \"فردریک تالبرگ\"","o":[[203989,"نسک \"از کوروش تا پهلوی\"","بخامه ی \"فردریک تالبرگ\"","","",1,"1346"]],"r":[],"no":1,"nr":0},"گریگوری فراید":{"n":"گریگوری فراید","o":[[205405,"پولموس هایدگر","گریگوری فراید","","",1,""]],"r":[],"no":1,"nr":0},"برزیل":{"n":"برزیل","o":[[205709,"ملت‌های مدرن جهان","برزیل","","",1,""]],"r":[],"no":1,"nr":0},"حدود یک مساله":{"n":"حدود یک مسأله","o":[[206090,"الهیات سیاسی","چیستی و حدود یک مسأله","","",1,""]],"r":[],"no":1,"nr":0},"برنارد بورژوا":{"n":"برنارد بورژوا","o":[[206658,"واژگان هگل","برنارد بورژوا","","",2,""]],"r":[],"no":1,"nr":0},"فیلیپ لگرین":{"n":"فیلیپ لگرین","o":[[207185,"واقعیت جهانی شدن","فیلیپ لگرین","","",1,""]],"r":[],"no":1,"nr":0},"نشرگمان":{"n":"نشرگمان","o":[[207447,"ترجمه خشایار دیهمیی","نشرگمان","","",1,""],[211173,"چرا و چگونه اشتباهاتمان را