ارتی به ایران، روابط پارت و روم، شیوۀ پادشاهی و حکومت آنان، اقتصاد و جامعۀ ایشان، دین و طرز به خاک سپردن مردگان، معماری، هنر، برافتادن و انقراض آنان، و آثار به‌جای‌مانده از ایشان است. در این کتاب نسبتاً مختصر و پرمایه مؤلف کوشیده است که از همۀ منابع مربوط به پارتی‌ها بهره برگیرد و با دقت‌نظر و حوصله‌ای بسیار به تحریر فصل‌های کتاب خود بپردازد. مؤلف به‌طور کلی سعی داشته که حتی‌المقدور از وقایع‌نگاری و بیان حوادث خونین و شرح جنگ‌ها کاسته و بر تاریخ مردم و جامعه و فرهنگ و هنر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","","",2,""]],"r":[],"no":1,"nr":0},"بوالقاسم رفیعی مهرابادی":{"n":"بوالقاسم رفیعی مهرآبادی","o":[[201382,"آثار ملی اصفهان","بوالقاسم رفیعی مهرآبادی","","",1,"1352"]],"r":[],"no":1,"nr":0},"داوود اقاعلی گل":{"n":"داوود آقاعلی گل","o":[[201999,"(۶۱۲۷): مطالعات آزمایشگاهی تعدادی از مهره های آبی و سبز به کار رفته در زیورآلات پیش از تاریخ موزه ملی ایران","رویا بهادری، داوود آقاعلی گل","","",1,""]],"r":[],"no":1,"nr":0},"در تقابل با استعمارگران":{"n":"در تقابل با استعمارگران","o":[[204446,"برای نخستین بار در اینترنت","در این کتاب با هفت شرکت نفتی بزرگ جهان آشنا می‌شوید و خواهید دید که چطور محمدرضا شاه با تأسیس سازمان \" اوپِک\" (OPEC) و متحد کردن کشورهای نفت‌خیز، نه تنها برای حقوق ملت ایران، بلکه برای گرفتن حق سایر کشورهای جهان گام بر میداشت و چگونه در دهه هفتاد میلادی (دهه پنجاه خورشیدی)، در تقابل با استعمارگران، شاهنشاه ایران قیمت نفت را چهار برابر کرد","","",1,"1357"]],"r":[],"no":1,"nr":0},"درباره ذات":{"n":"دربارهٔ ذات","o":[[205244,"متافیزیک ارسطو، تتا (Θ) ۱–۳","دربارهٔ ذات و فعلیتِ قوه","","",1,""]],"r":[],"no":1,"nr":0},"خاستگاه نژادباوری":{"n":"خاستگاه نژادباوری","o":[[205898,"افسانه خون","خاستگاه نژادباوری","","",1,""]],"r":[],"no":1,"nr":0},"نشرخانه معنا":{"n":"نشرخانه معنا","o":[[210485,"ترجمه مسیحا برزگر","نشرخانه معنا،چاپ اول۱۳۸۳","","",1,"1383"]],"r":[],"no":1,"nr":0},"نشرپرسش":{"n":"نشرپرسش","o":[[210682,"ترجمه ناهید احمدیان","نشرپرسش،چاپ دوم۱۳۹۰","","",1,"1390"]],"r":[],"no":1,"nr":0},"امیرحسین فرخ زادنیا