ت که در حدود سال 1605 میلادی به رشته ی تحریر درآمد. این نمایشنامه به سقوط تدریجی شخصیت اصلی داستان، شاه لیر، به سوی دیوانگی و جنون می پردازد. شاه لیر به خاطر این که دو تن از سه دخترش در چاپلوسی و مجیزگویی از او موفق هستند، قلمرو پادشاهیِ خود را به آن ها می بخشد و باعث می شود عواقب تراژیک و غم انگیزی برای کل خانواده رقم بخورد. این نمایشنامه که از ماجرای اسطوره ایِ پادشاهی سلتیک به نام «لیرِ بریتانیا» گرفته شده، مورد اقتباس های بی شماری در تئاتر و سینما قرار گرفته و وظیفه ی اجرای نقش اصلی آن، به برترین و موفق ترین بازیگران هنرهای نمایشی سپرده شده است. شکسپیر در این اثر، عاطفه، بی رحمی، حمایت، غرور، خِرد و ضعف ان","","",1,"1403"]],"r":[],"no":1,"nr":0},"دکتر عباس کی منش":{"n":"دکتر عباس کی منش","o":[[81812,"طالب آملی","دکتر عباس کی منش","","",2,""],[85205,"طالب آملی و صور خیال در دیوان او","دکتر عباس کی منش","","",1,""],[85387,"پرتو عرفان ؛ شرح اصطلاحات عرفانی کلیات شمس ؛ جلد اول","دکتر عباس کی منش","","اول",1,"1366"],[85388,"پرتو عرفان ؛ شرح اصطلاحات عرفانی کلیات شمس ؛ جلد دوم","دکتر عباس کی منش","","دوم",1,"1366"]],"r":[],"no":4,"nr":0},"ابوالفضل محمد بن حسین بیهقی":{"n":"ابوالفضل محمد بن حسین بیهقی","o":[[82805,"دیبای دیداری","ابوالفضل محمد بن حسین بیهقی","","",6,"1390"],[167580,"تاریخ بیهقی","ابوالفضل محمد بن حسین بیهقی","","",2,"1386"],[167581,"تاریخ بیهقی جلد دوم","ابوالفضل محمد بن حسین بیهقی","","دوم",1,"1386"],[167582,"تاریخ بیهقی جلد اول","ابوالفضل محمد بن حسین بیهقی","","اول",1,"1386"]],"r":[],"no":4,"nr":0},"دکتر کاووس حسن لی":{"n":"دکتر کاووس حسن‌لی","o":[[84036,"فرهنگ سعدی‌پژوهی","دکتر کاووس حسن‌لی","","",2,"1380"]],"r":[],"no":1,"nr":0},"ان شرلی":{"n":"آن شرلی","o":[[84687,"چهارم","آن شرلی","سارا قدیانی","",1,""],[84688,"سوم","آن شرلی","سارا قدیانی","",1,""],[84689,"دوم","آن شرلی","سارا قدیانی","",1,""],[84690,"اول","آن شرلی","سارا قدیانی","",1,""]],"r":[],"no":4,"nr":0},"جمال الدین ابوروح لطف الله بن ابی سعد":{"n":"جمال الدین ابوروح لطف الله بن ابی سعد","o":[[85551,"حالات و سخنان ابوسعید ابوالخیر","جمال الدین ابوروح لطف الله بن ابی سعد","","",2,"1366"]],