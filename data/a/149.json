ن و خدا مطرح می کند. کی یرکگور با نثری فوق العاده روان و روشن، این مسئله ی سخت و پیچیده را بررسی می کند و از روش های مختلف تفسیر داستان کهن ابراهیم به منظور انتقال مفاهیم مورد نظر خود بهره می گیرد. سورن کی یرکگو","\" ترس و لرز\"؛ سورن کیرکه گارد","عبدالکریم رشیدیان","",1,""]],"r":[],"no":1,"nr":0},"لیلا فاضل":{"n":"لیلا فاضل","o":[[201025,"بررسی اهمیت خط‌ سیر باستانی فهرج-اسپی (نصرت‌آباد) در اواخر دوره ساسانی تا پایان عصر سلجوقی با تکیه بر کاروانسرای (رباط) نویافتهٔ بیابان گرگ در حاشیهٔ لوت جنوبی","لیلا فاضل، یعقوب محمدی‌فر","","",1,""],[201907,"(۶۲۳۳): شناسایی و معرفی مسیر باستانی بیشاپور - فیروزآباد (اردشیرخره) در دوره ساسانی و قرون اولیه اسلامی","کمال الدین نیکنامی، لیلا فاضل","","",1,""],[202085,"(۶۰۱۶): بررسی و تحلیل بنای میرآباد امامقلی؛ آتشکده ای نویافته از دوره ساسانی در ریگان - استان کرمان","یعقوب محمدی فر، لیلا فاضل، اسماعیل همتی ازندریانی","","",1,""]],"r":[],"no":3,"nr":0},"نوشته نایومی میلر":{"n":"نوشتۀ نائومی میلر","o":[[203467,"گیاه باستان شناسی در ایران","نوشتۀ نائومی میلر","","",1,""]],"r":[],"no":1,"nr":0},"دابلیو وی کواین":{"n":"دابلیو وی. کواین","o":[[207194,"شبکه باور","دابلیو وی. کواین و جی.اس اولیان","امیر دیوانی","",1,"1381"]],"r":[],"no":1,"nr":0},"نشرباران":{"n":"نشرباران","o":[[209089,"جستارهایی در زمینه نقد","نشرباران،سوئد،چاپ جدید۱۴۰۱","","",1,"1401"]],"r":[],"no":1,"nr":0},"موسسه مطالعات تاریخ پزشکی":{"n":"موسسه مطالعات‌ تاریخ پزشکی","o":[[210797,"ترجمه میرزا شهاب","موسسه مطالعات‌ تاریخ پزشکی","","",1,""]],"r":[],"no":1,"nr":0},"ترجمه دکتر محمدنبی سربلوکی":{"n":"ترجمه دکتر محمدنبی سربلوکی","o":[[210866,"farin ebook","ترجمه دکتر محمدنبی سربلوکی","","",1,""]],"r":[],"no":1,"nr":0},"فاطمه امیدی":{"n":"فاطمه امیدی","o":[],"r":[[215051,"چطور در شرایط عدم قطعیت تصمیمات هوشمندانه تری بگیریم","","فاطمه امیدی","",1,""]],"no":0,"nr":1},"جوجو":{"n":"جوجو","o":[[216057,"خلیج نقره‌ ای","مویز، جوجو، ۱۹۶۹ - م.","کیومرث پارسای","",1,"1396"]],"r":[],"no":1,"nr":0},"گفتگویی با اسلاوی ژیژک":{"n":"گفتگویی با اسلاوی ژیژک","o":[[224746,"گشودن فضای فلسفه","گف