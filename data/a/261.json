اب نسبتاً مختصر و پرمایه مؤلف کوشیده است که از همۀ منابع مربوط به پارتی‌ها بهره برگیرد و با دقت‌نظر و حوصله‌ای بسیار به تحریر فصل‌های کتاب خود بپردازد. مؤلف به‌طور کلی سعی داشته که حتی‌المقدور از وقایع‌نگاری و بیان حوادث خونین و شرح جنگ‌ها کاسته و بر تاریخ مردم و جامعه و فرهنگ و هنر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","","",2,"","","",42],[204905,"رساله قوانین","فیلسوف برجسته اواخر بیزانس، کتابی برای کسانی که می‌خواهند از پشت صحنه تحولات فکری یکی از مهم‌ترین دوره‌های گذار تاریخ اروپا سر دربیاورند؛ اثری که در آن فلسفه نوافلاطونی، سیاست، قانون، دین و رؤیای بازسازی نظم اجتماعی درهم می‌آمیزند. آنچه امروز از این اثر در دست داریم، بخش‌هایی برجامانده از رساله‌ای بزرگ‌تر است که در قرن نوزدهم با جست‌وجو و مقابله نسخه‌های خطی گردآوری و منتشر شده و مقدمه مفصل کتاب نیز زندگی و اندیشه پلتون و تلاش او برای احیای نوعی نظام دینی و اخلاقی بر پایه میراث یونان باستان را بررسی می‌کند. این کتاب می‌تواند فرصتی جذاب باشد تا با اندیشمندی آشنا شود که در مرز میان جهان مسیحی، میراث یونانی و اندیشه سیاسی قرار گرفته و پرسش‌هایی ماندگار درباره قانون، جامعه، دی","","",1,"","","l",38],[226075,"تفسیر کتاب مقدس برای ایمانداران","ایوب، مزامیر، امثال، جامعه، غزل غزلها)؛ ویلیام مک دونالد","انتشارات توماس نیلسون؛آمریکا","",1,"","","",41]],"r":[],"no":5,"nr":0},"یوزف مارکورات":{"n":"یوزف مارکورات","o":[[1592,"ایرانشهر بر مبنای جغرافیای بطلمیوس","یوزف مارکورات","دکتر مریم میراحمدی","",1,"1373","اطلاعات‌","9",0],[1593,"ایرانشهر بر مبنای جغرافیای موسی خورنی","یوزف مارکورات","","",1,"1373","اطلاعات‌","9",0]],"r":[],"no":2,"nr":0},"پطرس دی سرکیس گیلانتز":{"n":"پطرس دی سرکیس گیلانتز","o":[[1741,"سقوط اصفهان","پطرس دی سرکیس گیلانتز","محمد مهریار","",1,"","","",0],[16963,"سقوط اصفهان","پطرس دی سرکیس گیلانتز","","",2,"","","",3]],"r":[],"no":2,"nr":0},"برای بچه های ریش دار":{"n":"برای بچه های ریش دار","o":[[2042,"قصه های کوتاه","برای بچه های ریش دار","","",3,"","","",0]],"r":[],"no":1,"nr":0},"جزیره گرگها جلد 8":{"n":"جزیره گرگها جلد 8","o":[[3942,"نبرد با شیاطین","