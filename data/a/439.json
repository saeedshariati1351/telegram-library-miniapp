ن و انقراض آنان، و آثار به‌جای‌مانده از ایشان است. در این کتاب نسبتاً مختصر و پرمایه مؤلف کوشیده است که از همۀ منابع مربوط به پارتی‌ها بهره برگیرد و با دقت‌نظر و حوصله‌ای بسیار به تحریر فصل‌های کتاب خود بپردازد. مؤلف به‌طور کلی سعی داشته که حتی‌المقدور از وقایع‌نگاری و بیان حوادث خونین و شرح جنگ‌ها کاسته و بر تاریخ مردم و جامعه و فرهنگ و هنر آن دوره بیفزاید. از این جهت تاریخی که دربارۀ پارتیان نوشته آیینۀ روزگار آن قوم است","","",2,""]],"r":[],"no":1,"nr":0},"بھارہ مقدم":{"n":"بھارہ مقدم","o":[[201854,"مقاله: بررسی و تحلیل نقوش سنگ نگارہ ھای مجموعه‌ باستانی کال سیر، سیر خردو و مھدوا، شهرستان طرقبه شاندیز در شمال‌شرق ایران","مهدی دھمردہ، حسن باصفا، بھارہ مقدم، علی کریمی کیا","","",1,""]],"r":[],"no":1,"nr":0},"فری ای یانگ":{"n":"فری ای یانگ","o":[[204698,"زندگی خود را دوباره بیافرینید","فری ای یانگ","","",1,"1402"]],"r":[],"no":1,"nr":0},"تلاش او برای احیای نوعی نظام دینی":{"n":"تلاش او برای احیای نوعی نظام دینی","o":[[204905,"رساله قوانین","فیلسوف برجسته اواخر بیزانس، کتابی برای کسانی که می‌خواهند از پشت صحنه تحولات فکری یکی از مهم‌ترین دوره‌های گذار تاریخ اروپا سر دربیاورند؛ اثری که در آن فلسفه نوافلاطونی، سیاست، قانون، دین و رؤیای بازسازی نظم اجتماعی درهم می‌آمیزند. آنچه امروز از این اثر در دست داریم، بخش‌هایی برجامانده از رساله‌ای بزرگ‌تر است که در قرن نوزدهم با جست‌وجو و مقابله نسخه‌های خطی گردآوری و منتشر شده و مقدمه مفصل کتاب نیز زندگی و اندیشه پلتون و تلاش او برای احیای نوعی نظام دینی و اخلاقی بر پایه میراث یونان باستان را بررسی می‌کند. این کتاب می‌تواند فرصتی جذاب باشد تا با اندیشمندی آشنا شود که در مرز میان جهان مسیحی، میراث یونانی و اندیشه سیاسی قرار گرفته و پرسش‌هایی ماندگار درباره قانون، جامعه، دی","","",1,""]],"r":[],"no":1,"nr":0},"کاترین کلارک":{"n":"کاترین کلارک","o":[[205917,"مسکو، رُم چهارم","کاترین کلارک","","",1,""]],"r":[],"no":1,"nr":0},"هنری تامسن رایل":{"n":"هنری تامسن رائل","o":[[206486,"رم در عصر اگوست","هنری تامسن رائل","ابوطالب صارمی","",1,"1349"]],"r":[],"no":1,"nr":0},"نشرامیرکبیر":{"n":"نشرامیرکبیر","o":[[207450,"تصحیح و تحشیه دکتر منص