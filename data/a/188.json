ه باعث شهرت او شده بود ، نوشته بود. 154 غزل - که همه آنها به جز دو مورد خطاب به یک مرد جوان زیبا ، ، یا یک \"خانم \" خیانتکار است - حاوی برخی از نفیس ترین و شگفت انگیزترین شعرهایی است که تا کنون سروده شده است و به موضوعات ابدی مانند عشق و خیانت، حافظه و ویرانی می‌پردازد","","",1,""],[81837,"شوالیه دارمانتال","داستان در اوایل قرن هجدهم میلادی و دوران نیابت سلطنت فیلیپ دوم، دوک اورلئان در فرانسه می‌گذرد. دوما در این کتاب، با آمیختن واقعیت‌های تاریخی و تخیل خلاقانه خود، فضایی پر از جاسوسی، عشق، خیانت و دوئل‌های پرهیجان خلق کرده است","","",1,"1371"]],"r":[],"no":2,"nr":0},"یادداشت های شخصی":{"n":"یادداشت های شخصی","o":[[82184,"مادر ترزا","یادداشت های شخصی","پروین ادیب","",1,""],[94397,"مادرترزا","یادداشت های شخصی","پروین ادیب","",2,""]],"r":[],"no":2,"nr":0},"تنظیم مجدد حسین داودی":{"n":"تنظیم مجدد حسین داودی","o":[],"r":[[82980,"احادیث و قصص مثنوی:( تلفیقی از دو کتاب \" احادیث مثنوی\" و ماخذ قصص و \" تمثیلات مثنوی\"","بدیع الزمان فروزانفر","کامل و تنظیم مجدد حسین داودی","",1,"1381"]],"no":0,"nr":1},"کلماتی که به خاطر نمی اوریم استفاده می شود":{"n":"کلماتی که به‌خاطر نمی‌آوریم استفاده می‌شود","o":[[83288,"فرهنگ طیفی","فرهنگ طیفی یک فرهنگ لغت به زبان فارسی (فارسی به فارسی) تألیف جمشید فراروی است که برای یافتن واژه‌های مترادف و کلماتی که به‌خاطر نمی‌آوریم استفاده می‌شود؛ واژه‌هایی که، به زبان خودمانی، نوک زبانمان است و با کمک گرفتن از لغات مترادف یا مرتبط با آن در کتاب فرهنگ طیفی، آن لغات به یادمان می‌آید","","",1,""]],"r":[],"no":1,"nr":0},"محمد حجت":{"n":"محمد حجت","o":[[83516,"نمود آموزه های عرفانی در اشعار بیدل دهلوی","محمد حجت","","",1,""]],"r":[],"no":1,"nr":0},"استاد بدیع الرمان فروزانفر":{"n":"استاد بدیع الرمان فروزانفر","o":[[85933,"دیوان سنایی غزنوی","استاد بدیع الرمان فروزانفر","","",1,""]],"r":[],"no":1,"nr":0},"حسین افشار":{"n":"حسین افشار","o":[],"r":[[87693,"و حتی یک کلمه هم نگفت","هاینریش بل","حسین افشار","",1,"1364"]],"no":0,"nr":1},"ابوالمعالی محمد بن الحسین العلوی":{"n":"ابوالمعالی محمد بن الحسین العلوی","o":[[87928,"بیان الادیان","ابوالمعالی محمد بن ال