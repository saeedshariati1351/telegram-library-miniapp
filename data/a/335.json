 ضد دیکتاتوری هایی که دنیا را می بلعید شناخته شد بیان می کند … در جنگ‌های خندقی ۵ چیز اهمیت دارد : هیزم و غذا و توتون و شمع و دشمن. در جبهه ساراگوسا در زمستان، درجه اهمیت این پنج چیز به همان ترتیبی بود که ذکر شد، منتها دشمن با فاصله زیادی در درجه پنجم قرار داشت …","جورج ارول","تورج آرامش","",1,""],[255396,"قلعه حیوانات","جورج ارول","","",1,""]],"r":[],"no":3,"nr":0},"مصطفی ابوالنصر الشلبی":{"n":"مصطفی ابوالنصر الشلبی","o":[[99342,"زنان پیرامون پیامبر","محمود مهدی استانبولی، مصطفی ابوالنصر الشلبی","دکتر شهربانو دلبری","",2,""]],"r":[],"no":1,"nr":0},"کاوه باسمنجی کاووس باسمنجی":{"n":"کاوه باسمنجی کاووس باسمنجی","o":[],"r":[[102564,"\" روحانی و شاه \"","دزموند هارنی","کاوه باسمنجی کاووس باسمنجی","",1,"1402"]],"no":0,"nr":1},"سیامک وطنی":{"n":"سیامک وطنی","o":[],"r":[[102567,"\" ارتعاش فکر \"","ویلیام واکر آتکینستون","سیامک وطنی","",2,"1397"],[228564,"ارتعاش فکر","ویلیام واکر آتکینسون","سیامک وطنی","",1,"1397"]],"no":0,"nr":2},"رستاخیز":{"n":"رستاخیز","o":[[123491,"ادبیات داستان","رستاخیز","","",2,""]],"r":[],"no":1,"nr":0},"شفابخشی روحی":{"n":"شفابخشیِ روحی","o":[[123640,"روانشناسی موفقیت","شفابخشیِ روحی","","",3,""]],"r":[],"no":1,"nr":0},"جادوگر شهر زمرد":{"n":"جادوگر شهر زمرّد","o":[[123787,"ادبیات داستان","جادوگر شهر زمرّد","","",1,""]],"r":[],"no":1,"nr":0},"غریزه خوشبختی":{"n":"غریزه خوشبختی","o":[[123969,"ادبیات داستان","غریزه خوشبختی","","",1,""]],"r":[],"no":1,"nr":0},"ملکه مصر":{"n":"ملکه مصر","o":[[124423,"ادبیات داستان","ملکه مصر","","",2,""]],"r":[],"no":1,"nr":0},"فاطمه باقری باران":{"n":"فاطمه باقری باران","o":[],"r":[[126801,"وقت تنهایی","استفانی روزنبلوم","فاطمه باقری باران","",1,"1402"]],"no":0,"nr":1},"دکتر زرقانی":{"n":"دکتر زرقانی","o":[[128472,"تاریخ ادبیات","دکتر زرقانی","","",2,"1394"]],"r":[],"no":1,"nr":0},"دانیل هوتنلوچر":{"n":"دانیل هوتنلوچر","o":[[129383,"عصر هوش مصنوعی و آینده ما انسان ها","هنری کیسینجر، اریک اشمیت، دانیل هوتنلوچر","علی علی پناهی","",1,"1401"]],"r":[],"no":1,"nr":0},"مایک اسمیت":{"n":"مایک اسمیت","o":[[129554,"برد شما از 