ود. چون هیچ تلاشی بی‌اشتباه و کاستی نیست؛ ولی کسی که تلاش می‌کند، کسی که اشتیاق را می‌شناسد، کسی که ایثار می‌کند و خود را وقف هدفی والا می‌سازد، همان کسی است که در بهترین حالت طعم پیروزی را بیش از دیگران می‌چشد و در بدترین حالت و در صورت شکست، حداقل پر دل و جرئت، شکست می‌خورد","","",1,""]],"r":[],"no":1,"nr":0},"david brooks":{"n":"David Brooks","o":[[254051,"The Social Animal","David Brooks","","",1,""]],"r":[],"no":1,"nr":0},"ژوین 2016":{"n":"ژوئن 2016","o":[[257163,"بوردا","ژوئن 2016","","",1,""]],"r":[],"no":1,"nr":0},"174 صفحه":{"n":"۱۷۴ صفحه","o":[[259190,"یکرنگی","۱۷۴ صفحه","","",1,""]],"r":[],"no":1,"nr":0},"ترجمه مبانی رفتار سازمانی":{"n":"ترجمه مبانی رفتار سازمانی","o":[[259343,"خلاصه کتاب","ترجمه مبانی رفتار سازمانی؛ رابینز","","",1,""]],"r":[],"no":1,"nr":0},"جوزف استگلیتز":{"n":"جوزف استگلیتز","o":[[260477,"سقوط آزاد","جوزف استگلیتز","","",1,""]],"r":[],"no":1,"nr":0},"فاضل محمود ولی":{"n":"فاضل محمود ولی","o":[],"r":[[264897,"اسبی از گلبرگ آلاله»","","فاضل محمود ولی","",1,""]],"no":0,"nr":1}}