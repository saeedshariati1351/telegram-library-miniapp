صغر معززی","","",1,"1376"]],"r":[],"no":1,"nr":0},"اکیو":{"n":"آکیو","o":[[229243,"سفرنامه کازاما: سفرنامه و خاطرات آکی ئو کازاما نخستین وزیر مختار ژاپن در ایران ( 1308 تا 1311خورشیدی). آکیو کازاما","کازاما، آکیو، - ۱۸۸۵","هاشم رجب زاده","",1,"1380"]],"r":[],"no":1,"nr":0},"محمد حسن قدیری ابیانه":{"n":"محمد حسن قدیری ابیانه","o":[[235069,"مقاله: زن در اسلام و غرب","محمد حسن قدیری ابیانه","","",2,""]],"r":[],"no":1,"nr":0},"تابستان 1402 تیک خورده":{"n":"تابستان ۱۴۰۲ تیک خورده","o":[[240047,"حقوق ثبت","آخرین دوره؛ تابستان ۱۴۰۲ تیک خورده","","",1,""]],"r":[],"no":1,"nr":0},"دکتر رامین صمدی":{"n":"دکتر رامین صمدی","o":[[241559,"جزوه زمین شناسی اقتصادی گروه زمین آزمون (آمادگی آزمون کارشناسی ارشد زمین شناسی)","دکتر رامین صمدی","","",3,""]],"r":[],"no":1,"nr":0},"فیض اله شیرزادی":{"n":"فیض اله شیرزادی","o":[[245809,"خلاصه کتاب اصول حسابداری 2","دکتر ایرج نوروش و فیض اله شیرزادی","","",3,""]],"r":[],"no":1,"nr":0},"سی اس لوییس کلایو استیپلز لوییس":{"n":"سی اس لوییس کلایو استیپلز لوییس","o":[[253176,"نارنیا آخرین نبرد","سی اس لوییس کلایو استیپلز لوییس؛ تیرین» ، آخرین پادشاه نارنیا ، زمانی که با خبر شد اصلان در آن نزدیکی دیده شده است بسیار خوشحال شد، اما به وسیلۀ موجودی به نام « قنطورس» که نیمه انسان و نیمه اسب بود، باخبر گردید که اسلان در آن‌جا نیست، زیرا ستاره‌ها دارای ترکیب خوبی نبوده‌اند؛ شاه تیرین در حالی که مشغول نجات حیوانات و درختان از دست اذیت و آزار کالرمن‌ها، که به نام اسلان این اعمال را انجام می‌دادند، بود، به وسیلۀ آن‌ها دستگیر و گرفتار شد و او را نزد شیفت که موجودی بین میمون و انسان بود ، بردند؛ شیفت او را به درختی بست تا از گرسنگی بمیرد. شاه تیرین در حالت بیهوشی، خود را میان لیدی مولی و لرد دیگوری دید و","","",1,"1379"],[253177,"نارنیا صندلی نقره ای","سی اس لوییس کلایو استیپلز لوییس؛ جیل‌ پولی و یوستس به طور اتفاقی به دنیای « نارنیا» راه می‌یابند و از طرف « اصلان» ، خالق دنیای نارنیا، ماموریت می‌یابند تا ریلین پسر شاه کاسپین را بیابند و نزد پدرش بازگردانند","","",1,"1379"],[253178,"نارنیا سفر کشتی سپیده پیما","سی اس لوییس کلایو استیپلز لوییس؛ در این رمان، ادموند و لوسی پِوِنسی (به همراه پسر عمویشان یوستاس اسکراب)؛ سی .اس.لوئیس ، نویسنده این کتاب هیجان انگیز ، این جلد از داستان را به « جفری کوربت » تقدیم کرد. کوربت که بعداً نام خود را به جفری بارفیلد تغییر داد، پسر خوانده اوون بارفیلد، دوست لوئیس است","","",1,""],[253179,"نارنیا شاهزاده کاسپین","سی اس لوییس کلایو استیپلز لوییس؛ توطئه‌ای تازه نارنیا را تهدید می‌کند؛ متوجه میشوند در آنجا هزاران سال گذشته است","","",1,"1379"],[253180,"نارنیا اسب و آدمش","سی اس لوییس کلایو استیپلز لوییس؛ پیتر شاه بزرگ نارنیا ، است و برادر و دو خواهرش ، شاه و ملکه‌هایِ فرمان‌بردار او هستند‌؛ آرابیس و شاستا ، با سرعت هر چه بیشتر راهی","","",1,"1379"],[253181,"نارنیا شیر کمد جادوگر","سی اس لوییس کلایو استیپلز لوییس؛ لوسی پس از چند ساعت از نارنیا بازمی‌گردد و متوجه می‌شود که فقط چند ثانیه از زمین دور‌ بوده‌است، زیرا بازدید از سرزمین جادویی نارنیا بیشتر از مدت عدم حضور آن‌ها در زمین طول می‌کشد. وقتی لوسی درباره نارنیا به خواهر و برادرانش می‌گوید، آن‌ها حرف او را باور نمی‌کنند؛ ادموند با جادوگر سفید ملاقات می‌کند، جادوگر ادموند را فریب می‌دهد و او را متقاعد می‌کند که خواهران و برادرش را با قول شاهزاده شدن نزد او بیاورد","","",1,"1402"],[253182,"نارنیا خواهرزاده جادوگر","سی اس لوییس کلایو استیپلز لوییس؛ پیتر ، سوزان ، ادموند و لوسی پونسی برای در امان ماندن از بمب‌باران جنگ جهانی دوم در سال ۱۹۴۰، از لندن به خانه پروفسور دیگوری کریک، که در حومه انگلستان است، می‌روند. لوسی هنگام گشت‌وگذار در خانه، به طور اتفاقی وارد کمد لباس می‌شود و وارد سرزمین جادویی نارنیا می‌شود. او در آنجا، یک « فایون » به نام آقای تامنس را ملاقات می‌کند","","",1,"1940"]],"r":[],"no":7,"nr":0},"و پژوهش علی اصغر حقدار":{"n":"و پژوهش علی‌اصغر حقدار","o":[],"r":[[267880,"بابی‌ها و ناصرالدین شاه","سلیمان نظیف","و پژوهش علی‌اصغر حقدار","",1,"1399"]],"no":0,"nr":1},"asmaeyl ra yn 2 2":{"n":"asmaeyl ra yn 2(2)","o":[[268120,"dryanvrdy ayranyan","asmaeyl ra yn 2(2)","","",1,""]],"r":[],"no":1,"nr":0}}