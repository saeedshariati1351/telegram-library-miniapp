شی درباره سرنوشت تمدن غرب","o":[[204975,"عصر سکولاریزاسیون","یکی از مهم‌ترین متفکران سیاسی و فلسفی ایتالیا که تلاشی ژرف برای فهم ریشه‌های بحران معنوی و فرهنگی جهان مدرن است. نویسنده با نگاهی تاریخی و فلسفی نشان می‌دهد که سکولاریزاسیون صرفاً جدایی دین از سیاست نیست، بلکه فرآیندی عمیق است که شیوه اندیشیدن، اخلاق، فرهنگ و حتی معنای انسان بودن را دگرگون کرده است. نویسنده با تحلیل جریان‌هایی چون مارکسیسم، تکنوکراسی، جامعه مصرفی، انقلاب‌های فرهنگی دهه ۱۹۶۰ و نسبت مسیحیت با مدرنیته، خواننده را به بازاندیشی درباره سرنوشت تمدن غرب و آینده ارزش‌های انسانی دعوت می‌کند. کتاب برای علاقه‌مندان فلسفه، الهیات، اندیشه سیاسی و نقد مدرنیته، اثری تأمل‌برانگیز و الهام‌بخش است که بسیاری از پرسش‌های امروز را از منظری متفاوت و عمیق بررسی می‌کند","","",1,"","","",38]],"r":[],"no":1,"nr":0},"ژاک بنینی بوسویه":{"n":"ژاک بنینی بوسوئه","o":[[206460,"سیاست ملهم از کتاب مقدس","ژاک بنینی بوسوئه","","",2,"","","",40],[206461,"گفتار درباره‌ی تاریخ جهان","ژاک بنینی بوسوئه","","",2,"","","",40]],"r":[],"no":2,"nr":0},"چاپخانه اتحادیه تهران":{"n":"چاپخانه اتحادیه تهران","o":[[208186,"ترجمه حمزه سردادور طالب زاده","چاپخانه اتحادیه تهران،چاپ اول۱۳۰۸","","",1,"1308","","",39]],"r":[],"no":1,"nr":0},"نشرهرمس1393":{"n":"نشرهرمس۱۳۹۳","o":[[211640,"ترجمه بابک سراسکانی","نشرهرمس۱۳۹۳","","",1,"1393","","",39]],"r":[],"no":1,"nr":0},"انتشارات نیل1339":{"n":"انتشارات نیل۱۳۳۹","o":[[211668,"ترجمه داریوش همایون","انتشارات نیل۱۳۳۹","","",1,"1339","","",39]],"r":[],"no":1,"nr":0},"وینزر":{"n":"وینزر","o":[[217301,"نیروی شفابخش برای فکر،بدن و روان","وینزر، چارمیان","کامبیز ربانی","",2,"1383","ثالث","6",39]],"r":[],"no":1,"nr":0},"تنظیم":{"n":"تنظیم","o":[],"r":[[219271,"بخش دوم داروهای مفرده","","تنظیم و تحقیق دکترسلیمان افشاری پور","",1,"","","",39],[219272,"بخش اول داروهای مفرده","","تنظیم و تحقیق دکترسلیمان افشاری پور","",1,"","","",39]],"no":0,"nr":2},"نباید یک شخصیت متفاوت را":{"n":"نباید یک شخصیت متفاوت را","o":[[223612,"برای عاشق شدن","نباید یک شخصیت متفاوت را","","",3,"","","",39]],"r":[],"no":1,"nr":0},"نوشته