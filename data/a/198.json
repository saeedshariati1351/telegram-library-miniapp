یرضا هژبری نوبری","","",1,"","","",33]],"r":[],"no":1,"nr":0},"پرستو نعیمه طریی":{"n":"پرستو نعیمه طرئی","o":[[203684,"(۵۵٧١): باستان شناسی معادن و فلزکاری کهن در حاشیه کویر لوت، مطالعه ویژه: بخش دیهوک شهرستان طبس","ذبیح الله مسعودی، عابد تقوی، حسن هاشمی زرج آباد، پرستو نعیمه طرئی","","",1,"","","",33]],"r":[],"no":1,"nr":0},"گفتگوی بهمن امیرحسینی با داریوش همایون":{"n":"گفتگوی بهمن امیرحسینی با داریوش همایون","o":[[204285,"من و روزگارم","گفتگوی بهمن امیرحسینی با داریوش همایون","","",1,"","فصلنامه تلاش","",35]],"r":[],"no":1,"nr":0},"ابولکلام ازاد":{"n":"ابولکلام آزاد","o":[[204773,"کوروش کبیر","ابولکلام آزاد","","",1,"1386","نشر علم‌","2",36]],"r":[],"no":1,"nr":0},"باور ما هستند":{"n":"باور ما هستند","o":[[204873,"در دفاع از واقع‌گرایی اخلاقی","آیا خوب و بد، درست و نادرست، واقعیت‌هایی مستقل از سلیقه، قرارداد و باور ما هستند، یا اخلاق چیزی است که خود انسان‌ها می‌سازند؟ نویسنده با ورود به قلب مباحث فرااخلاق، از واقع‌گرایی اخلاقی دفاع می‌کند و در مسیر خود با دیدگاه‌هایی مانند نسبی‌گرایی، ذهن‌گرایی و نظریه‌های غیرشناخت‌گرایانه به گفت‌وگو و جدال می‌پردازد؛ اما جذابیت کتاب فقط در دفاع از یک موضع فلسفی نیست، بلکه در پرسش‌هایی است که مستقیماً به تجربه اخلاقی ما مربوط می‌شوند: اگر حقیقت اخلاقی وجود دارد، چگونه می‌توانیم آن را بشناسیم؟ چرا باید به آن عمل کنیم؟ آیا اختلاف‌نظرهای عمیق اخلاقی واقع‌گرایی را زیر سؤال می‌برند؟ و آیا علم تنها معیار شناخت واقعیت است؟ این کتاب که ساختاری نظام‌من","","",1,"","","",38]],"r":[],"no":1,"nr":0},"بلکه فرایندی عمیق است که شیوه اندیشیدن":{"n":"بلکه فرآیندی عمیق است که شیوه اندیشیدن","o":[[204975,"عصر سکولاریزاسیون","یکی از مهم‌ترین متفکران سیاسی و فلسفی ایتالیا که تلاشی ژرف برای فهم ریشه‌های بحران معنوی و فرهنگی جهان مدرن است. نویسنده با نگاهی تاریخی و فلسفی نشان می‌دهد که سکولاریزاسیون صرفاً جدایی دین از سیاست نیست، بلکه فرآیندی عمیق است که شیوه اندیشیدن، اخلاق، فرهنگ و حتی معنای انسان بودن را دگرگون کرده است. نویسنده با تحلیل جریان‌هایی چون مارکسیسم، تکنوکراسی، جامعه مصرفی، انقلاب‌های فرهنگی دهه ۱۹۶۰ و نسبت مسیحیت با مدرنیته، خواننده را به بازاندیشی درباره سرنوشت تمدن غرب و آینده ارزش‌های انسانی دعوت می‌کند. کتاب برای علاقه‌مندان فلسفه، الهیات، اندیشه سیاسی و نقد مدرنیته، اثری تأمل‌برانگیز و الهام‌بخش است که بسیاری از پرسش‌های امروز را از منظری متفاوت و عمیق بررسی می‌کند","","",1,"","","",38]],"r":[],"no":1,"nr":0},"سرگذشت فلسفه سیاسی جدید":{"n":"سرگذشت فلسفهٔ سیاسی جدید","o":[[205190,"ظهور و زوالِ سیطرهٔ عقلانی","سرگذشت فلسفهٔ سیاسی جدید","","",1,"","","",38]],"r":[],"no":1,"nr":0},"چاپ اول1391":{"n":"چاپ اول۱۳۹۱","o":[[207630,"باهتمام جواد صفی نژاد","دنیای جغرافیای سحاب،چاپ اول۱۳۹۱","","",1,"1391","","",39],[207661,"تاریخ، فرهنگ و جغرافیای منطقه ای","نشرالیاس،چاپ اول۱۳۹۱","","",1,"1391","","",39],[207664,"به سرکردگی سالار فاتح و پیوستن آنها به نهضت گیلان","نشرمامک،چاپ اول۱۳۹۱","","",1,"1391","","",39],[207835,"۳۳۰دستورپخت گیاهی برای سلامتی","نشرصبح صادق،چاپ اول۱۳۹۱","","",1,"1391","","",39],[208279,"دریانوردی بادبانی در خلیج فارس و اقیانوس هند","نشرنو،چاپ اول۱۳۹۱","","",1,"1391","","",39],[208769,"نصایح پدر ثروتمند برای دستیابی به استقلال مالی","نشرستوس،چاپ اول۱۳۹۱","برج سازان جوان","",1,"1391","","",39],[209297,"ترجمه فاطمه السادات موسوی","انتشارات ما و شما،چاپ اول۱۳۹۱","","",1,"1391","","",39],[209600,"لوسیندا دیکن دیویس","انتشارات فرهنگ معاصر،چاپ اول۱۳۹۱","شهین دخت سرلتی صنعتی","",1,"1391","","",39],[209932,"بخش هایی از کتاب","نشربیان معنوی،چاپ اول۱۳۹۱","","",1,"1391","","",39],[209944,"ترجمه منوچهر صانعی دره بیدی","انتشارات ققنوس، چاپ اول۱۳۹۱","","",1,"1391","","",39],[210171,"ترجمه بهمن فرزانه","انتشارات ققنوس، چاپ اول۱۳۹۱","","",1,"1391","","",39],[210344,"تحلیل و ارزیابی تشکیل امپراتوری هخامنشیان","انتشارات شاپورخواست،چاپ اول۱۳۹۱","","",1,"1391","","",39],[210492,"ترجمه شیرین یزدانی","نشرارمغان گیلار،چاپ اول۱۳۹۱","","",1,"1391","","",39],[210584,"جلداول","انتشارات مطبوعات دینی،چاپ اول۱۳۹۱","","",1,"1391","","",39]],"r":[],"no":14,"nr":0},"انتشارات چترنگ1396":{"n":"انتشارات چترنگ۱۳۹۶","o":[[209457,"ترجمه مهدی فیاضی کیا","انتشارات چترنگ۱۳۹۶","","",1,"1396","","",39],[209940,"ترجمه علی قانع","